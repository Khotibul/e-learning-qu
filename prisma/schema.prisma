  siswa    Siswa?    @relation(fields: [siswaId], references: [id], onDelete: SetNull)
  agentLog AgentLog? @relation(fields: [agentLogId], references: [id], onDelete: SetNull)

  @@index([siswaId])
  @@index([agentLogId])
  @@map("agent_feedback")

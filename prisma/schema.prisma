  @@map("agent_quality_metrics")
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InterventionTipe {
  REMEDIAL
  TUGAS_TAMBAHAN
  MENTORING
  REKOMENDASI_MATERI
  KONSULTASI
  FOLLOW_UP
}

model Intervention {
  id        String             @id @default(uuid()) @db.Uuid
  siswaId   String             @db.Uuid
  guruId    String             @db.Uuid
  tipe      InterventionTipe
  reason    String             @db.Text
  action    String             @db.Text
  deadline  DateTime?
  status    InterventionStatus @default(OPEN)
  notes     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  guru  Guru  @relation(fields: [guruId], references: [id], onDelete: Cascade)

  @@index([siswaId])
  @@index([guruId])
  @@index([status])
  @@map("intervention")
}

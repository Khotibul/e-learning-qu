model AgentFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  siswaId    String?  @db.Uuid
  agentLogId String?  @db.Uuid
  messageId  String?  @db.Uuid
  rating     Int
  category   String?
  comment    String?  @db.Text
  helpful    Boolean?
  accurate   Boolean?

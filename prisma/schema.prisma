generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  SISWA
  RESEARCHER
}

enum MasteryKategori {
  BEGINNER
  BASIC
  DEVELOPING
  PROFICIENT
  ADVANCED
}

enum AktivitasJenis {
  LOGIN
  LOGOUT
  MATERI_DIBUKA
  MATERI_SELESAI
  SOAL_DIKERJAKAN
  LATIHAN_DIMULAI
  LATIHAN_SELESAI
  AI_CHAT
  ASSESSMENT_DIMULAI
  ASSESSMENT_SELESAI
  PRETEST
  POSTTEST
  REKOMENDASI_DIKLIK
}

enum RekomendasiTipe {
  MATERI
  LATIHAN
  ASSESSMENT
  VIDEO
}

enum RekomendasiStatus {
  BARU
  DIAKSES
  SELESAI
}

enum PathItemStatus {
  PENDING
  SEDANG
  SELESAI
}

enum TingkatKesulitan {
  MUDAH
  SEDANG
  SULIT
}

enum JenisSoal {
  PILIHAN_GANDA
  ESSAY
  TRUE_FALSE
  MATCHING
  ISIAN_SINGKAT
}

enum StatusUjian {
  DRAFT
  AKTIF
  SELESAI
  DITUTUP
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  password      String?
  emailVerified DateTime?
  role          Role      @default(SISWA)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  guru          Guru?
  siswa         Siswa?
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  pengumuman    Pengumuman[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Guru {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  nip       String?   @unique
  nuptk     String?
  nama      String
  jabatan   String?   @db.VarChar(20)
  alamat    String?
  noTelp    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas          Kelas[]
  soal           Soal[]
  ujian          Ujian[]
  penilaianEssay PenilaianEssay[]
  materis        Materi[]
  courses        Course[]
  pengajaran     Pengajaran[]
  interventions  Intervention[]

  @@map("guru")
}

model Siswa {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  nis       String?   @unique
  nisn      String?
  nama      String
  alamat    String?
  noTelp    String?
  kelasId   String?   @db.Uuid
  jurusanId String?   @db.Uuid
  jabatan   String?   @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas           Kelas?                 @relation(fields: [kelasId], references: [id])
  jurusan         Jurusan?               @relation(fields: [jurusanId], references: [id])
  jawabanUjian    JawabanUjian[]
  chatSessions    ChatSession[]
  latihanAI       LatihanAI[]
  agentLogs       AgentLog[]
  jawabanLatihan  JawabanLatihan[]
  nilai           Nilai[]
  AbsensiSiswa    AbsensiSiswa[]
  jadwalPiket     JadwalPiket[]
  pembayaranIuran PembayaranIuran[]
  pembayaranDenda PembayaranDenda[]
  pelanggaran     Pelanggaran[]
  penguasaan      PenguasaanKompetensi[]
  aktivitas       LearningActivity[]
  rekomendasi     Rekomendasi[]
  learningPaths   LearningPath[]
  profile         StudentProfile?
  earlyWarnings   EarlyWarning[]
  pretestPosttest PretestPosttest[]
  susResponses    SUSResponse[]
  aiEvaluations   AIEvaluation[]
  agentFeedbacks  AgentFeedback[]
  interventions   Intervention[]

  @@map("siswa")
}

model Jurusan {
  id        String    @id @default(uuid()) @db.Uuid
  kode      String    @unique
  nama      String
  deskripsi String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  siswas      Siswa[]
  kompetensis Kompetensi[]

  @@map("jurusan")
}

model Kompetensi {
  id              String    @id @default(uuid()) @db.Uuid
  kode            String
  nama            String
  deskripsi       String?
  jurusanId       String    @db.Uuid
  mataPelajaranId String?   @db.Uuid
  tingkat         Int       @default(1)
  urutan          Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  jurusan           Jurusan                @relation(fields: [jurusanId], references: [id])
  mataPelajaran     MataPelajaran?         @relation(fields: [mataPelajaranId], references: [id])
  materis           Materi[]
  soals             Soal[]
  penguasaan        PenguasaanKompetensi[]
  rekomendasi       Rekomendasi[]
  learningPaths     LearningPath[]
  learningPathItems LearningPathItem[]
  prasyarat         KompetensiPrasyarat[]  @relation("KompetensiPrasyarat")
  diprasyaratiOleh  KompetensiPrasyarat[]  @relation("KompetensiPrasyaratReverse")

  @@unique([kode, jurusanId])
  @@map("kompetensi")
}

model KompetensiPrasyarat {
  id                    String @id @default(uuid()) @db.Uuid
  kompetensiId          String @db.Uuid
  prasyaratKompetensiId String @db.Uuid

  kompetensi          Kompetensi @relation("KompetensiPrasyarat", fields: [kompetensiId], references: [id], onDelete: Cascade)
  prasyaratKompetensi Kompetensi @relation("KompetensiPrasyaratReverse", fields: [prasyaratKompetensiId], references: [id], onDelete: Cascade)

  @@unique([kompetensiId, prasyaratKompetensiId])
  @@map("kompetensi_prasyarat")
}

model PenguasaanKompetensi {
  id              String          @id @default(uuid()) @db.Uuid
  siswaId         String          @db.Uuid
  kompetensiId    String          @db.Uuid
  skor            Int             @default(0)
  kategori        MasteryKategori @default(BEGINNER)
  jumlahSoalBenar Int             @default(0)
  jumlahSoalSalah Int             @default(0)
  jumlahLatihan   Int             @default(0)
  jumlahChat      Int             @default(0)
  jumlahMateri    Int             @default(0)
  jumlahNilai     Int             @default(0)
  rataNilaiMapel  Float?
  terakhirDinilai DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  siswa      Siswa      @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kompetensi Kompetensi @relation(fields: [kompetensiId], references: [id], onDelete: Cascade)

  @@unique([siswaId, kompetensiId])
  @@index([kompetensiId])
  @@map("penguasaan_kompetensi")
}

model LearningActivity {
  id              String         @id @default(uuid()) @db.Uuid
  siswaId         String         @db.Uuid
  jenis           AktivitasJenis
  kompetensiId    String?        @db.Uuid
  mataPelajaranId String?        @db.Uuid
  targetId        String?
  detail          Json?
  durationMs      Int?
  createdAt       DateTime       @default(now())

  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@index([siswaId, createdAt])
  @@map("learning_activity")
}

model Rekomendasi {
  id           String            @id @default(uuid()) @db.Uuid
  siswaId      String            @db.Uuid
  kompetensiId String?           @db.Uuid
  materiId     String?           @db.Uuid
  tipe         RekomendasiTipe
  judul        String
  alasan       String
  prioritas    Int               @default(1)
  status       RekomendasiStatus @default(BARU)
  sumber       String            @default("adaptive")
  createdAt    DateTime          @default(now())

  siswa      Siswa       @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kompetensi Kompetensi? @relation(fields: [kompetensiId], references: [id])

  @@index([siswaId, status])
  @@map("rekomendasi")
}

model LearningPath {
  id           String   @id @default(uuid()) @db.Uuid
  siswaId      String   @unique @db.Uuid
  kompetensiId String?  @db.Uuid
  progres      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siswa      Siswa              @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kompetensi Kompetensi?        @relation(fields: [kompetensiId], references: [id])
  items      LearningPathItem[]

  @@map("learning_path")
}

model LearningPathItem {
  id             String         @id @default(uuid()) @db.Uuid
  learningPathId String         @db.Uuid
  kompetensiId   String?        @db.Uuid
  materiId       String?        @db.Uuid
  jenis          AktivitasJenis
  urutan         Int
  status         PathItemStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  kompetensi   Kompetensi?  @relation(fields: [kompetensiId], references: [id])
  materi       Materi?      @relation(fields: [materiId], references: [id])

  @@index([learningPathId, urutan])
  @@map("learning_path_item")
}

model Kelas {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  tingkat   Int
  guruId    String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  guru            Guru?              @relation(fields: [guruId], references: [id])
  siswas          Siswa[]
  ujians          Ujian[]
  jadwalPelajaran JadwalPelajaran[]
  pengumuman      Pengumuman[]
  Absensi         Absensi[]
  jadwalPiket     JadwalPiket[]
  iuran           Iuran[]
  denda           Denda[]
  pengeluaran     PengeluaranKelas[]
  pengajaran      Pengajaran[]
  pelanggaran     Pelanggaran[]

  @@map("kelas")
}

model MataPelajaran {
  id         String    @id @default(uuid()) @db.Uuid
  kode       String
  nama       String
  deskripsi  String?
  semesterId String    @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  semester        Semester          @relation(fields: [semesterId], references: [id])
  soals           Soal[]
  ujians          Ujian[]
  jadwalPelajaran JadwalPelajaran[]
  nilai           Nilai[]
  Absensi         Absensi[]
  materis         Materi[]
  courses         Course[]
  pengajaran      Pengajaran[]
  kompetensis     Kompetensi[]
  pretestPosttest PretestPosttest[]

  @@unique([kode, semesterId])
  @@map("mata_pelajaran")
}

model Pengajaran {
  id              String    @id @default(uuid()) @db.Uuid
  mataPelajaranId String    @db.Uuid
  guruId          String    @db.Uuid
  kelasId         String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  guru          Guru          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([mataPelajaranId, guruId, kelasId])
  @@map("pengajaran")
}

model TahunAjaran {
  id           String    @id @default(uuid()) @db.Uuid
  nama         String    @unique
  tahunMulai   Int
  tahunSelesai Int
  isAktif      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  semesters Semester[]
  ujians    Ujian[]

  @@map("tahun_ajaran")
}

model Semester {
  id            String    @id @default(uuid()) @db.Uuid
  nama          String
  tahunAjaranId String    @db.Uuid
  isAktif       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tahunAjaran    TahunAjaran     @relation(fields: [tahunAjaranId], references: [id])
  mataPelajarans MataPelajaran[]
  ujians         Ujian[]
  nilai          Nilai[]

  @@map("semester")
}

model Soal {
  id               String           @id @default(uuid()) @db.Uuid
  pertanyaan       String           @db.Text
  subSoal          Json?
  gambar           String?
  jenisSoal        JenisSoal
  tingkatKesulitan TingkatKesulitan @default(SEDANG)
  pilihanGanda     Json?
  trueFalse        Boolean?
  matching         Json?
  jawaban          String           @db.Text
  poin             Int              @default(1)
  bab              String?
  tags             String?
  kategoriId       String?          @db.Uuid
  kompetensiId     String?          @db.Uuid
  mataPelajaranId  String           @db.Uuid
  guruId           String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  kategori       KategoriSoal?    @relation(fields: [kategoriId], references: [id])
  kompetensi     Kompetensi?      @relation(fields: [kompetensiId], references: [id])
  mataPelajaran  MataPelajaran    @relation(fields: [mataPelajaranId], references: [id])
  guru           Guru             @relation(fields: [guruId], references: [id])
  ujianSoal      UjianSoal[]
  jawabanUjian   JawabanUjian[]
  jawabanLatihan JawabanLatihan[]

  @@map("soal")
}

model KategoriSoal {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  soals Soal[]

  @@map("kategori_soal")
}

model Ujian {
  id              String      @id @default(uuid()) @db.Uuid
  nama            String
  deskripsi       String?     @db.Text
  mataPelajaranId String      @db.Uuid
  kelasId         String      @db.Uuid
  guruId          String      @db.Uuid
  tahunAjaranId   String      @db.Uuid
  semesterId      String      @db.Uuid
  jumlahSoal      Int
  nilaiMinimum    Int         @default(0)
  durasi          Int
  tanggal         DateTime
  jamMulai        DateTime
  jamSelesai      DateTime
  mode            String      @default("manual")
  status          StatusUjian @default(DRAFT)
  tipe            String      @default("REGULER")
  isLatihan       Boolean     @default(false)
  randomSoal      Boolean     @default(true)
  randomJawaban   Boolean     @default(true)
  fullscreen      Boolean     @default(true)
  disableCopy     Boolean     @default(true)
  disablePaste    Boolean     @default(true)
  bisaRetake      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  mataPelajaran   MataPelajaran     @relation(fields: [mataPelajaranId], references: [id])
  kelas           Kelas             @relation(fields: [kelasId], references: [id])
  guru            Guru              @relation(fields: [guruId], references: [id])
  tahunAjaran     TahunAjaran       @relation(fields: [tahunAjaranId], references: [id])
  semester        Semester          @relation(fields: [semesterId], references: [id])
  ujianSoal       UjianSoal[]
  jawabanUjian    JawabanUjian[]
  nilai           Nilai[]
  pretestPosttest PretestPosttest[]

  @@map("ujian")
}

model UjianSoal {
  id      String @id @default(uuid()) @db.Uuid
  ujianId String @db.Uuid
  soalId  String @db.Uuid
  nomor   Int

  ujian Ujian @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  soal  Soal  @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([ujianId, soalId])
  @@map("ujian_soal")
}

model JawabanUjian {
  id          String   @id @default(uuid()) @db.Uuid
  ujianId     String   @db.Uuid
  siswaId     String   @db.Uuid
  soalId      String   @db.Uuid
  jawaban     String?  @db.Text
  esaiJawaban String?  @db.Text
  isCorrect   Boolean?
  poin        Int?
  raguRagu    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ujian          Ujian           @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  siswa          Siswa           @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  soal           Soal            @relation(fields: [soalId], references: [id], onDelete: Cascade)
  penilaianEssay PenilaianEssay?

  @@unique([ujianId, siswaId, soalId])
  @@map("jawaban_ujian")
}

model JawabanLatihan {
  id        String   @id @default(uuid()) @db.Uuid
  siswaId   String   @db.Uuid
  soalId    String   @db.Uuid
  jawaban   String?  @db.Text
  isCorrect Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  soal  Soal  @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@map("jawaban_latihan")
}

model Nilai {
  id              String    @id @default(uuid()) @db.Uuid
  siswaId         String    @db.Uuid
  ujianId         String?   @db.Uuid
  mataPelajaranId String    @db.Uuid
  semesterId      String    @db.Uuid
  nilai           Float
  jenis           String    @default("UJIAN")
  keterangan      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  ujian         Ujian?        @relation(fields: [ujianId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  semester      Semester      @relation(fields: [semesterId], references: [id])

  @@map("nilai")
}

model PenilaianEssay {
  id             String   @id @default(uuid()) @db.Uuid
  jawabanUjianId String   @unique @db.Uuid
  guruId         String   @db.Uuid
  nilai          Int
  komentar       String?  @db.Text
  catatan        String?  @db.Text
  rubrik         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jawabanUjian JawabanUjian @relation(fields: [jawabanUjianId], references: [id], onDelete: Cascade)
  guru         Guru         @relation(fields: [guruId], references: [id])

  @@map("penilaian_essay")
}

model JadwalPelajaran {
  id              String    @id @default(uuid()) @db.Uuid
  kelasId         String    @db.Uuid
  mataPelajaranId String    @db.Uuid
  hari            String
  jamMulai        String
  jamSelesai      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@map("jadwal_pelajaran")
}

model JadwalPiket {
  id        String   @id @default(uuid()) @db.Uuid
  kelasId   String   @db.Uuid
  siswaId   String   @db.Uuid
  hari      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([kelasId, siswaId, hari])
  @@map("jadwal_piket")
}

model Iuran {
  id        String    @id @default(uuid()) @db.Uuid
  kelasId   String    @db.Uuid
  nama      String
  nominal   Int
  tenggat   DateTime?
  deskripsi String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kelas      Kelas             @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  pembayaran PembayaranIuran[]

  @@map("iuran")
}

model PembayaranIuran {
  id           String   @id @default(uuid()) @db.Uuid
  iuranId      String   @db.Uuid
  siswaId      String   @db.Uuid
  jumlah       Int
  status       String   @default("LUNAS")
  tanggalBayar DateTime @default(now())
  keterangan   String?
  createdAt    DateTime @default(now())

  iuran Iuran @relation(fields: [iuranId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([iuranId, siswaId])
  @@map("pembayaran_iuran")
}

model Denda {
  id        String    @id @default(uuid()) @db.Uuid
  kelasId   String    @db.Uuid
  nama      String
  nominal   Int
  deskripsi String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kelas      Kelas             @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  pembayaran PembayaranDenda[]

  @@map("denda")
}

model PembayaranDenda {
  id           String   @id @default(uuid()) @db.Uuid
  dendaId      String   @db.Uuid
  siswaId      String   @db.Uuid
  jumlah       Int
  status       String   @default("LUNAS")
  tanggalBayar DateTime @default(now())
  keterangan   String?
  createdAt    DateTime @default(now())

  denda Denda @relation(fields: [dendaId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([dendaId, siswaId])
  @@map("pembayaran_denda")
}

model PengeluaranKelas {
  id         String    @id @default(uuid()) @db.Uuid
  kelasId    String    @db.Uuid
  jumlah     Int
  keterangan String
  tanggal    DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("pengeluaran_kelas")
}

model Pengumuman {

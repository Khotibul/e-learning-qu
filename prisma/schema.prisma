generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  SISWA
}

enum TingkatKesulitan {
  MUDAH
  SEDANG
  SULIT
}

enum JenisSoal {
  PILIHAN_GANDA
  ESSAY
  TRUE_FALSE
  MATCHING
  ISIAN_SINGKAT
}

enum StatusUjian {
  DRAFT
  AKTIF
  SELESAI
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  password      String?
  emailVerified DateTime?
  role          Role      @default(SISWA)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  guru          Guru?
  siswa         Siswa?
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  pengumuman    Pengumuman[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Guru {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  nip       String?   @unique
  nuptk     String?
  nama      String
  alamat    String?
  noTelp    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas          Kelas[]
  soal           Soal[]
  ujian          Ujian[]
  penilaianEssay PenilaianEssay[]
  materis        Materi[]
  pengajaran     Pengajaran[]

  @@map("guru")
}

model Siswa {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  nis       String?   @unique
  nisn      String?
  nama      String
  alamat    String?
  noTelp    String?
  kelasId   String?   @db.Uuid
  jabatan   String?   @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas            Kelas?            @relation(fields: [kelasId], references: [id])
  jawabanUjian     JawabanUjian[]
  jawabanLatihan   JawabanLatihan[]
  nilai            Nilai[]
  AbsensiSiswa     AbsensiSiswa[]
  jadwalPiket      JadwalPiket[]
  pembayaranIuran  PembayaranIuran[]
  pembayaranDenda  PembayaranDenda[]
  pelanggaran      Pelanggaran[]

  @@map("siswa")
}

model Kelas {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  tingkat   Int
  guruId    String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  guru            Guru?             @relation(fields: [guruId], references: [id])
  siswas          Siswa[]
  ujians          Ujian[]
  jadwalPelajaran JadwalPelajaran[]
  pengumuman      Pengumuman[]
  Absensi         Absensi[]
  jadwalPiket     JadwalPiket[]
  iuran           Iuran[]
  denda           Denda[]
  pengeluaran     PengeluaranKelas[]
  pengajaran      Pengajaran[]
  pelanggaran     Pelanggaran[]

  @@map("kelas")
}

model MataPelajaran {
  id         String    @id @default(uuid()) @db.Uuid
  kode       String
  nama       String
  deskripsi  String?
  semesterId String    @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  semester        Semester          @relation(fields: [semesterId], references: [id])
  soals           Soal[]
  ujians          Ujian[]
  jadwalPelajaran JadwalPelajaran[]
  nilai           Nilai[]
  Absensi         Absensi[]
  materis         Materi[]
  pengajaran      Pengajaran[]

  @@unique([kode, semesterId])
  @@map("mata_pelajaran")
}

model Pengajaran {
  id              String   @id @default(uuid()) @db.Uuid
  mataPelajaranId String   @db.Uuid
  guruId          String   @db.Uuid
  kelasId         String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  guru          Guru          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([mataPelajaranId, guruId, kelasId])
  @@map("pengajaran")
}

model TahunAjaran {
  id           String    @id @default(uuid()) @db.Uuid
  nama         String    @unique
  tahunMulai   Int
  tahunSelesai Int
  isAktif      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  semesters Semester[]
  ujians    Ujian[]

  @@map("tahun_ajaran")
}

model Semester {
  id            String    @id @default(uuid()) @db.Uuid
  nama          String
  tahunAjaranId String    @db.Uuid
  isAktif       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tahunAjaran    TahunAjaran     @relation(fields: [tahunAjaranId], references: [id])
  mataPelajarans MataPelajaran[]
  ujians         Ujian[]
  nilai          Nilai[]

  @@map("semester")
}

model Soal {
  id               String           @id @default(uuid()) @db.Uuid
  pertanyaan       String           @db.Text
  subSoal          Json?
  gambar           String?
  jenisSoal        JenisSoal
  tingkatKesulitan TingkatKesulitan @default(SEDANG)
  pilihanGanda     Json?
  trueFalse        Boolean?
  matching         Json?
  jawaban          String           @db.Text
  poin             Int              @default(1)
  bab              String?
  tags             String?
  kategoriId       String?          @db.Uuid
  mataPelajaranId  String           @db.Uuid
  guruId           String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  kategori       KategoriSoal?    @relation(fields: [kategoriId], references: [id])
  mataPelajaran  MataPelajaran    @relation(fields: [mataPelajaranId], references: [id])
  guru           Guru             @relation(fields: [guruId], references: [id])
  ujianSoal      UjianSoal[]
  jawabanUjian   JawabanUjian[]
  jawabanLatihan JawabanLatihan[]

  @@map("soal")
}

model KategoriSoal {
  id        String    @id @default(uuid()) @db.Uuid
  nama      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  soals Soal[]

  @@map("kategori_soal")
}

model Ujian {
  id              String      @id @default(uuid()) @db.Uuid
  nama            String
  deskripsi       String?     @db.Text
  mataPelajaranId String      @db.Uuid
  kelasId         String      @db.Uuid
  guruId          String      @db.Uuid
  tahunAjaranId   String      @db.Uuid
  semesterId      String      @db.Uuid
  jumlahSoal      Int
  nilaiMinimum    Int         @default(0)
  durasi          Int
  tanggal         DateTime
  jamMulai        DateTime
  jamSelesai      DateTime
  mode            String      @default("manual")
  status          StatusUjian @default(DRAFT)
  isLatihan       Boolean     @default(false)
  randomSoal      Boolean     @default(true)
  randomJawaban   Boolean     @default(true)
  fullscreen      Boolean     @default(true)
  disableCopy     Boolean     @default(true)
  disablePaste    Boolean     @default(true)
  bisaRetake      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  mataPelajaran MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  kelas         Kelas          @relation(fields: [kelasId], references: [id])
  guru          Guru           @relation(fields: [guruId], references: [id])
  tahunAjaran   TahunAjaran    @relation(fields: [tahunAjaranId], references: [id])
  semester      Semester       @relation(fields: [semesterId], references: [id])
  ujianSoal     UjianSoal[]
  jawabanUjian  JawabanUjian[]
  nilai         Nilai[]

  @@map("ujian")
}

model UjianSoal {
  id      String @id @default(uuid()) @db.Uuid
  ujianId String @db.Uuid
  soalId  String @db.Uuid
  nomor   Int

  ujian Ujian @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  soal  Soal  @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([ujianId, soalId])
  @@map("ujian_soal")
}

model JawabanUjian {
  id          String   @id @default(uuid()) @db.Uuid
  ujianId     String   @db.Uuid
  siswaId     String   @db.Uuid
  soalId      String   @db.Uuid
  jawaban     String?  @db.Text
  esaiJawaban String?  @db.Text
  isCorrect   Boolean?
  poin        Int?
  raguRagu    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ujian          Ujian           @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  siswa          Siswa           @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  soal           Soal            @relation(fields: [soalId], references: [id], onDelete: Cascade)
  penilaianEssay PenilaianEssay?

  @@unique([ujianId, siswaId, soalId])
  @@map("jawaban_ujian")
}

model JawabanLatihan {
  id        String   @id @default(uuid()) @db.Uuid
  siswaId   String   @db.Uuid
  soalId    String   @db.Uuid
  jawaban   String?  @db.Text
  isCorrect Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  soal  Soal  @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@map("jawaban_latihan")
}

model Nilai {
  id              String    @id @default(uuid()) @db.Uuid
  siswaId         String    @db.Uuid
  ujianId         String?   @db.Uuid
  mataPelajaranId String    @db.Uuid
  semesterId      String    @db.Uuid
  nilai           Float
  jenis           String    @default("UJIAN")
  keterangan      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  ujian         Ujian?        @relation(fields: [ujianId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  semester      Semester      @relation(fields: [semesterId], references: [id])

  @@map("nilai")
}

model PenilaianEssay {
  id             String   @id @default(uuid()) @db.Uuid
  jawabanUjianId String   @unique @db.Uuid
  guruId         String   @db.Uuid
  nilai          Int
  komentar       String?  @db.Text
  catatan        String?  @db.Text
  rubrik         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jawabanUjian JawabanUjian @relation(fields: [jawabanUjianId], references: [id], onDelete: Cascade)
  guru         Guru         @relation(fields: [guruId], references: [id])

  @@map("penilaian_essay")
}

model JadwalPelajaran {
  id              String    @id @default(uuid()) @db.Uuid
  kelasId         String    @db.Uuid
  mataPelajaranId String    @db.Uuid
  hari            String
  jamMulai        String
  jamSelesai      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@map("jadwal_pelajaran")
}

model JadwalPiket {
  id        String   @id @default(uuid()) @db.Uuid
  kelasId   String   @db.Uuid
  siswaId   String   @db.Uuid
  hari      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([kelasId, siswaId, hari])
  @@map("jadwal_piket")
}

model Iuran {
  id           String    @id @default(uuid()) @db.Uuid
  kelasId      String    @db.Uuid
  nama         String
  nominal      Int
  tenggat      DateTime?
  deskripsi    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  kelas      Kelas             @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  pembayaran PembayaranIuran[]

  @@map("iuran")
}

model PembayaranIuran {
  id          String   @id @default(uuid()) @db.Uuid
  iuranId     String   @db.Uuid
  siswaId     String   @db.Uuid
  jumlah      Int
  status      String   @default("LUNAS")
  tanggalBayar DateTime @default(now())
  keterangan  String?
  createdAt   DateTime @default(now())

  iuran Iuran @relation(fields: [iuranId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([iuranId, siswaId])
  @@map("pembayaran_iuran")
}

model Denda {
  id           String    @id @default(uuid()) @db.Uuid
  kelasId      String    @db.Uuid
  nama         String
  nominal      Int
  deskripsi    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  kelas      Kelas             @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  pembayaran PembayaranDenda[]

  @@map("denda")
}

model PembayaranDenda {
  id           String   @id @default(uuid()) @db.Uuid
  dendaId      String   @db.Uuid
  siswaId      String   @db.Uuid
  jumlah       Int
  status       String   @default("LUNAS")
  tanggalBayar DateTime @default(now())
  keterangan   String?
  createdAt    DateTime @default(now())

  denda Denda @relation(fields: [dendaId], references: [id], onDelete: Cascade)
  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([dendaId, siswaId])
  @@map("pembayaran_denda")
}

model PengeluaranKelas {
  id          String   @id @default(uuid()) @db.Uuid
  kelasId     String   @db.Uuid
  jumlah      Int
  keterangan  String
  tanggal     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("pengeluaran_kelas")
}

model Pengumuman {
  id        String    @id @default(uuid()) @db.Uuid
  judul     String
  isi       String    @db.Text
  gambar    String?
  lampiran  String?
  tipe      String    @default("UMUM")
  userId    String    @db.Uuid
  kelasId   String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User   @relation(fields: [userId], references: [id])
  kelas Kelas? @relation(fields: [kelasId], references: [id])

  @@map("pengumuman")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  judul     String
  pesan     String   @db.Text
  tipe      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum StatusAbsensi {
  HADIR
  TIDAK_HADIR
  IZIN
  SAKIT
  ALPA
}

model Absensi {
  id              String   @id @default(uuid()) @db.Uuid
  kelasId         String   @db.Uuid
  mataPelajaranId String   @db.Uuid
  tanggal         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kelas         Kelas          @relation(fields: [kelasId], references: [id])
  mataPelajaran MataPelajaran  @relation(fields: [mataPelajaranId], references: [id])
  siswa         AbsensiSiswa[]

  @@map("absensi")
}

model AbsensiSiswa {
  id         String        @id @default(uuid()) @db.Uuid
  absensiId  String        @db.Uuid
  siswaId    String        @db.Uuid
  status     StatusAbsensi @default(HADIR)
  keterangan String?
  createdAt  DateTime      @default(now())

  absensi Absensi @relation(fields: [absensiId], references: [id], onDelete: Cascade)
  siswa   Siswa   @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([absensiId, siswaId])
  @@map("absensi_siswa")
}

model Materi {
  id              String   @id @default(uuid()) @db.Uuid
  judul           String
  deskripsi       String?
  fileUrl         String
  fileType        String?
  fileSize        Int?
  mataPelajaranId String   @db.Uuid
  guruId          String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  guru          Guru          @relation(fields: [guruId], references: [id])

  @@map("materi")
}

model SiteConfig {
  id          String   @id @default(uuid()) @db.Uuid
  siteName    String   @default("E-Learning QU")
  tagline     String   @default("Platform E-Learning Modern")
  description String   @default("Platform pembelajaran digital modern yang menghubungkan Guru dan Siswa dalam ekosistem belajar yang interaktif, terstruktur, dan menyenangkan.")
  logoUrl     String?
  aboutTitle  String   @default("Tentang Kami")
  aboutText   String   @default("E-Learning QU adalah platform pembelajaran digital modern yang menghubungkan Guru dan Siswa dalam ekosistem belajar yang interaktif, terstruktur, dan menyenangkan.")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_config")
}

model LandingFeature {
  id          String   @id @default(uuid()) @db.Uuid
  icon        String   @default("FileText")
  title       String
  description String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_features")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  entity    String
  entityId  String?
  detail    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Pelanggaran {
  id        String   @id @default(uuid()) @db.Uuid
  siswaId   String   @db.Uuid
  kelasId   String   @db.Uuid
  jenis     String
  deskripsi String?
  poin      Int?
  tindakan  String?
  fotoUrl   String?
  tanggal   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  siswa Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@map("pelanggaran")
}

<UserControl x:Class="E_LearningQu.Desktop.Views.GuruIzinMusyrifView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1140">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Izin Musyrif" Style="{StaticResource H1}" />
                <TextBlock Text="Antrean persetujuan izin tahap musyrif + monitoring pondok" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,20"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Monitoring.Statistik.TotalSantri}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Total Santri" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Monitoring.DiPondok.Count}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                        <TextBlock Text="Di Pondok" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Monitoring.SedangIzin.Count}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushInfo}" />
                        <TextBlock Text="Sedang Izin" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Monitoring.Terlambat.Count}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushError}" />
                        <TextBlock Text="Terlambat" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Antrean Menunggu Musyrif" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Antrean}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Visibility="{Binding Antrean.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Santri" Binding="{Binding Santri.Nama}" Width="2*" />
                            <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="*" />
                            <DataGridTextColumn Header="Keluar" Binding="{Binding RencanaKeluar, StringFormat={}{0:dd/MM HH:mm}}" Width="*" />
                            <DataGridTextColumn Header="Kembali" Binding="{Binding RencanaKembali, StringFormat={}{0:dd/MM HH:mm}}" Width="*" />
                            <DataGridTemplateColumn Header="Alasan Tolak" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AlasanTolak, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0" Padding="6,4"
                                                 Foreground="{StaticResource BrushTextPrimary}"
                                                 ToolTip="Isi alasan penolakan (min. 5 huruf)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Setujui" Style="{StaticResource ButtonPillSuccess}"
                                                    Command="{Binding DataContext.SetujuiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Tolak" Style="{StaticResource ButtonPillDanger}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.TolakCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

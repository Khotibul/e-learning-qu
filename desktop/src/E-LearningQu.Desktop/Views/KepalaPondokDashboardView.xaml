<UserControl x:Class="E_LearningQu.Desktop.Views.KepalaPondokDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1160">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Kepala Pondok" Style="{StaticResource H1}" />
                <TextBlock Text="Dashboard pondok — keberadaan, izin, dan laporan" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Ringkasan -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,20"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ringkasan Pondok" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                    <UniformGrid Columns="6">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.TotalSantri}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Total Santri" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.DiPondok}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Di Pondok" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.IzinPulang}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushInfo}" />
                            <TextBlock Text="Izin Pulang" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.Terlambat}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Terlambat" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.IzinMenunggu}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Izin Menunggu" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Stats.TotalAsrama}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Asrama / Kamar" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Stats.KegiatanHariIni}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Kegiatan Hari Ini" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Stats.PengumumanMenunggu}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Pengumuman Menunggu" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Stats.PembinaanMenunggu}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Pembinaan Menunggu" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Stats.PelanggaranBulanIni}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Pelanggaran (bln)" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Keberadaan" Style="{StaticResource ButtonGhost}" Command="{Binding BukaKeberadaanCommand}" Margin="0,0,8,0" />
                <Button Content="Izin Menunggu" Style="{StaticResource ButtonGhost}" Command="{Binding BukaIzinCommand}" Margin="0,0,8,0" />
                <Button Content="Laporan" Style="{StaticResource ButtonGhost}" Command="{Binding BukaLaporanCommand}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Panel kiri: tab aktif -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                 <Grid>

                    <!-- Keberadaan -->
                    <Grid Visibility="{Binding KeberadaanAktif, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Santri di Luar Pondok" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Keberadaan}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding Keberadaan.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                                <DataGridTextColumn Header="NIS" Binding="{Binding NisNo}" Width="*" />
                                <DataGridTextColumn Header="Keberadaan" Binding="{Binding KeberadaanLabel}" Width="*" />
                                <DataGridTextColumn Header="Asrama" Binding="{Binding Asrama}" Width="*" />
                                <DataGridTextColumn Header="Kembali" Binding="{Binding IzinAktif.RencanaKembali, StringFormat={}{0:dd/MM HH:mm}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Izin menunggu -->
                    <Grid Visibility="{Binding IzinAktif, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Izin Menunggu Persetujuan Kepala" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding IzinMenunggu}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding IzinMenunggu.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Santri" Binding="{Binding Santri.Nama}" Width="2*" />
                                <DataGridTextColumn Header="No. Surat" Binding="{Binding SuratNomor}" Width="*" />
                                <DataGridTextColumn Header="Jenis" Binding="{Binding JenisLabel}" Width="*" />
                                <DataGridTextColumn Header="Alasan" Binding="{Binding Alasan}" Width="2*" />
                                <DataGridTemplateColumn Header="Aksi" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Setujui" Style="{StaticResource ButtonPillSuccess}"
                                                        Command="{Binding DataContext.PutuskanIzinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" />
                                                <Button Content="Tolak" Style="{StaticResource ButtonPillDanger}"
                                                        Command="{Binding DataContext.TolakIzinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Laporan -->
                    <Grid Visibility="{Binding LaporanAktif, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Laporan Bulan Berjalan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Laporan}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding Laporan.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Indikator" Binding="{Binding Label}" Width="3*" />
                                <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                 </Grid>
                </Border>

                <!-- Panel kanan: kegiatan mendatang -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Kegiatan Mendatang" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding KegiatanMendatang}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding KegiatanMendatang.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kegiatan" Binding="{Binding Nama}" Width="2*" />
                                <DataGridTextColumn Header="Tgl" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM}}" Width="*" />
                                <DataGridTextColumn Header="Jam" Binding="{Binding JamMulai}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

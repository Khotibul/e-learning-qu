<UserControl x:Class="E_LearningQu.Desktop.Views.StatCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="206" Margin="0,0,12,12">
    <Border Style="{StaticResource Card}" Padding="18,16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="{StaticResource ColorSurfaceAlt}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
            <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>

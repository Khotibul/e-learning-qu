<UserControl x:Class="E_LearningQu.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
            BorderThickness="1" BorderBrush="#DDD" CornerRadius="8" Padding="28">
        <StackPanel>
            <TextBlock Text="E-Learning-Qu" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Masuk dengan akun yang sama dengan website" FontSize="12"
                       Foreground="#666" HorizontalAlignment="Center" Margin="0,4,0,20" />

            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Margin="0,0,0,12" />

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4" />
            <PasswordBox Padding="8" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />

            <TextBlock Text="Masuk sebagai" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                      Padding="8" Margin="0,0,0,16" />

            <TextBlock Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <Binding Path="ErrorMessage" />
                </TextBlock.Text>
            </TextBlock>

            <Button Command="{Binding LoginCommand}" Padding="12" FontWeight="SemiBold" Margin="0,0,0,8">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Masuk" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="Memproses..." />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Command="{Binding LoginWithGoogleCommand}" Padding="12" FontWeight="SemiBold"
                    Background="#FFFFFF" Foreground="#333333" BorderBrush="#DDDDDD">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Masuk dengan Google" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="Memproses..." />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>

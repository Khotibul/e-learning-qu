<UserControl x:Class="E_LearningQu.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E_LearningQu.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="1220" d:DesignHeight="800">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:NotBoolToBoolConverter x:Key="NotBoolToBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Panel kiri: branding pesantren (dekoratif) -->
        <Border Grid.Column="0" Margin="64,0,48,0" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" MaxWidth="440">
                <!-- Ornamen atas -->
                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Image x:Name="BrandLogo" Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46"
                           Stretch="Uniform" />
                </Border>

                <TextBlock x:Name="BrandName" Text="E-Learning-Qu" Style="{StaticResource H1}"
                           Foreground="{StaticResource BrushTextOnDark}" FontSize="34"
                           TextWrapping="Wrap" MaxWidth="440" />
                <TextBlock x:Name="BrandTagline" Text="Pondok Pesantren Digital" Foreground="{StaticResource BrushAccent}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />

                <Border Height="2" Width="72" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Left" Margin="0,18,0,16" CornerRadius="1" />

                <TextBlock Style="{StaticResource TextBase}"
                           Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="14"
                           TextWrapping="Wrap" LineHeight="22">
                    <Run Text="Satu akun untuk seluruh aktivitas pesantren — " />
                    <Run Text="belajar, mengajar, administrasi, dan pengasuhan santri. " />
                    <Run Text="Sistem otomatis menyesuaikan tampilan dengan peran Anda." />
                </TextBlock>

                <!-- Fitur singkat -->
                <StackPanel Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="Kurikulum terpadu: kelas, diniyah &amp; tahfidz"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="AI Tutor &amp; analitik belajar real-time"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="Manajemen asrama, izin &amp; keuangan pondok"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Panel kanan: kartu login -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurface}" CornerRadius="22"
                Padding="40,36" VerticalAlignment="Center" Margin="0,0,64,0"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Width="430">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270"
                                  Color="#0A3A24" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Selamat datang kembali" Style="{StaticResource H2}" />
                <TextBlock Text="Masuk dengan akun yang sama dengan website &amp; aplikasi mobile"
                           Style="{StaticResource Muted}" Margin="0,6,0,22" />

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,0,14"
                         ToolTip="Gunakan email terdaftar di sistem pesantren" />

                <TextBlock Text="Kata Sandi" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}"
                             PasswordChanged="OnPasswordChanged" Margin="0,0,0,10"
                             ToolTip="Kata sandi akun Anda" />

                <!-- Info multi-login: role otomatis, tanpa pilihan manual -->
                <Border Background="{StaticResource BrushInfoBg}" CornerRadius="10" Padding="12,10"
                        Margin="0,4,0,18" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="Multi-login otomatis — peran (siswa, guru, pengurus pondok, dst) " />
                            <Run Text="langsung disesuaikan dengan akun Anda." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Pesan error -->
                <Border Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BrushError}"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                                   FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Tombol utama -->
                <Button Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBoolToBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Memproses…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Masuk" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold" FontSize="14" />
                </Button>

                <!-- Pemisah -->
                <Grid Margin="0,6,0,12">
                    <Line X1="0" Y1="8" X2="150" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                    <TextBlock Text="atau" HorizontalAlignment="Center" Background="{StaticResource BrushSurface}"
                               Padding="10,0" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Line X1="230" Y1="8" X2="380" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                </Grid>

                <!-- Tombol Google -->
                <Button Command="{Binding LoginWithGoogleCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBoolToBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGoogle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Memproses…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="G" FontSize="15" FontWeight="Bold" Margin="0,0,8,0"
                                   Foreground="{StaticResource BrushError}" />
                        <TextBlock Text="Masuk dengan Google" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Absensi kiosk: guru/siswa absen wajah & sidik jari tanpa login -->
                <Grid Margin="0,16,0,12">
                    <Line X1="0" Y1="8" X2="150" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                    <TextBlock Text="absensi tanpa login" HorizontalAlignment="Center" Background="{StaticResource BrushSurface}"
                               Padding="10,0" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" />
                    <Line X1="230" Y1="8" X2="380" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                </Grid>

                <Button Command="{Binding BukaKioskCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsKioskBusy, Converter={StaticResource NotBoolToBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKioskBusy}" Value="True">
                                    <Setter Property="Content" Value="Menyiapkan kiosk…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushPrimary}" />
                        <TextBlock Text="Absensi Wajah &amp; Sidik Jari" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushPrimary}" />
                    </StackPanel>
                </Button>

                <TextBlock FontSize="11" Style="{StaticResource Muted}" Margin="0,8,0,0" TextAlignment="Center"
                           Text="Khusus komputer admin/desktop. Aktifkan sekali dengan akun Admin — setelah itu absensi tidak perlu login." />

                <Button Command="{Binding AktifkanKioskGoogleCommand}" HorizontalAlignment="Center"
                        Style="{StaticResource ButtonGhost}" Padding="8,4" Margin="0,2,0,0"
                        IsEnabled="{Binding IsKioskBusy, Converter={StaticResource NotBoolToBool}}"
                        ToolTip="Admin yang login dengan Google (tanpa kata sandi) bisa mengaktifkan kiosk di komputer ini">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="G" FontSize="13" FontWeight="Bold" Margin="0,0,6,0"
                                   Foreground="{StaticResource BrushError}" VerticalAlignment="Center" />
                        <TextBlock Text="Admin tanpa kata sandi? Aktifkan dengan Google" FontSize="11.5"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding KioskMessage}" FontSize="11.5" Margin="0,6,0,0" TextAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                           Visibility="{Binding KioskMessage, Converter={StaticResource NullToVisibility}}" />

                <!-- Footer kecil -->
                <TextBlock Text="Dengan masuk, Anda menyetujui kebijakan data pesantren."
                           Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>

        <!-- ==================== KIOSK ABSENSI (di layar login) ==================== -->
        <Border x:Name="KioskOverlay" Grid.ColumnSpan="2" Panel.ZIndex="20"
                Background="{StaticResource BrushCanvas}"
                Visibility="{Binding IsKioskOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource BrushPrimaryDark}" Padding="24,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAccent}">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource BrushPrimaryDark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Absensi Kiosk — Wajah &amp; Sidik Jari" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextOnDark}" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource BrushTextOnDarkMuted}"
                                           Text="Tanpa login · identitas guru/siswa tampil otomatis · waktu mengikuti server" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Muat Ulang" Style="{StaticResource ButtonGoogle}" Padding="14,8"
                                    Click="OnMuatUlangKiosk" Margin="0,0,8,0" />
                            <Button Content="Lupakan Kiosk" Style="{StaticResource ButtonGoogle}" Padding="14,8"
                                    Command="{Binding LupakanKioskCommand}" Margin="0,0,8,0" />
                            <Button Content="Tutup" Style="{StaticResource ButtonAccent}" Padding="16,8"
                                    Click="OnTutupKiosk" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="KioskBrowser" />
                    <Border x:Name="KioskErrorPanel" Background="{StaticResource BrushCanvas}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{StaticResource BrushWarning}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Kiosk belum dapat dimuat" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="KioskErrorText" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0" Padding="24,10">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap">
                        Guru: nama, foto, jabatan, NIP, sekolah formal/non formal. Siswa: foto, nama, kelas, jurusan, NIS,
                        sekolah formal/non formal. Kartu identitas hilang sendiri setelah 25 detik agar kiosk siap dipakai orang berikutnya.
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

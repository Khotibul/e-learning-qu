<UserControl x:Class="E_LearningQu.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1220" d:DesignHeight="800">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:NotBoolToBoolConverter x:Key="NotBoolToBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Panel kiri: branding pesantren (dekoratif) -->
        <Border Grid.Column="0" Margin="64,0,48,0" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" MaxWidth="440">
                <!-- Ornamen atas -->
                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46"
                           Stretch="Uniform" />
                </Border>

                <TextBlock Text="E-Learning-Qu" Style="{StaticResource H1}"
                           Foreground="{StaticResource BrushTextOnDark}" FontSize="34" />
                <TextBlock Text="Pondok Pesantren Digital" Foreground="{StaticResource BrushAccent}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />

                <Border Height="2" Width="72" Background="{StaticResource BrushAccent}"
                        HorizontalAlignment="Left" Margin="0,18,0,16" CornerRadius="1" />

                <TextBlock Style="{StaticResource TextBase}"
                           Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="14"
                           TextWrapping="Wrap" LineHeight="22">
                    <Run Text="Satu akun untuk seluruh aktivitas pesantren — " />
                    <Run Text="belajar, mengajar, administrasi, dan pengasuhan santri. " />
                    <Run Text="Sistem otomatis menyesuaikan tampilan dengan peran Anda." />
                </TextBlock>

                <!-- Fitur singkat -->
                <StackPanel Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🎓" FontSize="15" Width="28" />
                        <TextBlock Text="Kurikulum terpadu: kelas, diniyah &amp; tahfidz"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🤖" FontSize="15" Width="28" />
                        <TextBlock Text="AI Tutor &amp; analitik belajar real-time"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕌" FontSize="15" Width="28" />
                        <TextBlock Text="Manajemen asrama, izin &amp; keuangan pondok"
                                   Foreground="{StaticResource BrushTextOnDarkMuted}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Panel kanan: kartu login -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurface}" CornerRadius="22"
                Padding="40,36" VerticalAlignment="Center" Margin="0,0,64,0"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Width="430">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270"
                                  Color="#0A3A24" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Selamat datang kembali" Style="{StaticResource H2}" />
                <TextBlock Text="Masuk dengan akun yang sama dengan website &amp; aplikasi mobile"
                           Style="{StaticResource Muted}" Margin="0,6,0,22" />

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,0,14"
                         ToolTip="Gunakan email terdaftar di sistem pesantren" />

                <TextBlock Text="Kata Sandi" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}"
                             PasswordChanged="OnPasswordChanged" Margin="0,0,0,10"
                             ToolTip="Kata sandi akun Anda" />

                <!-- Info multi-login: role otomatis, tanpa pilihan manual -->
                <Border Background="{StaticResource BrushInfoBg}" CornerRadius="10" Padding="12,10"
                        Margin="0,4,0,18" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="Multi-login otomatis — peran (siswa, guru, pengurus pondok, dst) " />
                            <Run Text="langsung disesuaikan dengan akun Anda." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Pesan error -->
                <Border Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="14" Foreground="{StaticResource BrushError}"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                                   FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Tombol utama -->
                <Button Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBoolToBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Memproses…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="Masuk" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold" FontSize="14" />
                </Button>

                <!-- Pemisah -->
                <Grid Margin="0,6,0,12">
                    <Line X1="0" Y1="8" X2="150" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                    <TextBlock Text="atau" HorizontalAlignment="Center" Background="{StaticResource BrushSurface}"
                               Padding="10,0" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Line X1="230" Y1="8" X2="380" Y2="8" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                </Grid>

                <!-- Tombol Google -->
                <Button Command="{Binding LoginWithGoogleCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBoolToBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGoogle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Memproses…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="G" FontSize="15" FontWeight="Bold" Margin="0,0,8,0"
                                   Foreground="{StaticResource BrushError}" />
                        <TextBlock Text="Masuk dengan Google" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Footer kecil -->
                <TextBlock Text="Dengan masuk, Anda menyetujui kebijakan data pesantren."
                           Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="E_LearningQu.Desktop.Views.GuruMuridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Murid" Style="{StaticResource H1}" />
                <TextBlock Text="Daftar murid dari kelas yang Anda ajar" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Width="240" Style="{StaticResource InputBox}" Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cari nama / NIS" />
                <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar Width="110" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Error -->
        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <!-- Empty -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="16" Padding="32,40"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="👨‍🎓" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Text="Belum ada murid ditemukan" Style="{StaticResource H2}" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="Murid muncul otomatis dari kelas yang Anda ajar" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource Grid}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas.Nama}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
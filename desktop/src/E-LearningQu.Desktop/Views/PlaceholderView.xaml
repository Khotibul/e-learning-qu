<UserControl x:Class="E_LearningQu.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Center"
                VerticalAlignment="Center" Padding="36">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="66" Height="66" CornerRadius="20" Background="{StaticResource BrushInfoBg}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                </Border>

                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                           Margin="0,16,0,0" TextAlignment="Center" />

                <TextBlock Text="Modul ini sedang disiapkan — datanya sudah tersedia di backend dan akan segera hadir di aplikasi desktop."
                           Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,10,0,0" TextAlignment="Center" MaxWidth="440" />

                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10" Padding="14,11"
                        Margin="0,20,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        HorizontalAlignment="Center" MaxWidth="440">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="Anda tetap bisa memantau data utama lewat dashboard beranda, atau lanjutkan lewat website &amp; aplikasi mobile."
                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

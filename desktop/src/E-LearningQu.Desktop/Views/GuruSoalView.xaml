<UserControl x:Class="E_LearningQu.Desktop.Views.GuruSoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Bank Soal" Style="{StaticResource H1}" />
                <TextBlock Text="Kelola soal yang Anda buat" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Width="240" Style="{StaticResource InputBox}" Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cari pertanyaan" />
                <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="16" Padding="32,40"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                <TextBlock Text="Belum ada soal" Style="{StaticResource H2}" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="Soal yang Anda buat akan muncul di sini" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource Grid}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pertanyaan" Binding="{Binding Pertanyaan}" Width="3*" />
                <DataGridTextColumn Header="Jenis" Binding="{Binding JenisSoal}" Width="*" />
                <DataGridTextColumn Header="Poin" Binding="{Binding Poin}" Width="60" />
                <DataGridTextColumn Header="Mapel" Binding="{Binding MataPelajaran.Nama}" Width="*" />
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Hapus" Style="{StaticResource ButtonRowDanger}" FontSize="12"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
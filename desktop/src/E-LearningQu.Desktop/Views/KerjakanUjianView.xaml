<UserControl x:Class="E_LearningQu.Desktop.Views.KerjakanUjianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Memuat ujian..." FontSize="16" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" VerticalAlignment="Center"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

        <!-- Panel hasil setelah submit -->
        <Border Visibility="{Binding Selesai, Converter={StaticResource BoolToVisibility}}"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" CornerRadius="10"
                BorderBrush="#DDD" BorderThickness="1" Background="White" MaxWidth="420">
            <StackPanel>
                <TextBlock Text="Ujian selesai" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Detail.Nama}" HorizontalAlignment="Center" Foreground="#555" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Hasil.Nilai}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock HorizontalAlignment="Center" Foreground="#666" Margin="0,4,0,0">
                    <Run Text="{Binding Hasil.JumlahBenar, Mode=OneWay}" /><Run Text=" benar dari " />
                    <Run Text="{Binding Hasil.JumlahSoal, Mode=OneWay}" /><Run Text=" soal" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Area kerja -->
        <Grid Visibility="{Binding Selesai, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Border DockPanel.Dock="Right" Background="#FFF8E1" Padding="10,4" CornerRadius="6">
                    <TextBlock Text="{Binding SisaWaktuText}" FontSize="18" FontWeight="Bold" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Detail.Nama}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding AutosaveText}" Foreground="#2E7D32" FontSize="11" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="56" Margin="0,0,0,8" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Soal}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Nomor}" Width="34" Height="30" Margin="0,0,6,4"
                                    Command="{Binding DataContext.PilihNomorCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Nomor}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="20" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SoalAktif.Pertanyaan}" TextWrapping="Wrap" FontSize="15" />
                        <TextBlock Text="{Binding SoalAktif.SoalInduk}" TextWrapping="Wrap" Foreground="#777" FontSize="12" Margin="0,4,0,0" />

                        <!-- Pilihan ganda -->
                        <ListBox ItemsSource="{Binding SoalAktif.PilihanGanda}"
                                 SelectedItem="{Binding PilihanTerpilih, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" Margin="0,14,0,0"
                                 Visibility="{Binding SoalAktif.IsPilihanGanda, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- True/False -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                    Visibility="{Binding SoalAktif.TrueFalse, Converter={StaticResource NullToVisibility}}">
                            <Button Content="Benar" Padding="16,8" Margin="0,0,8,0"
                                    Command="{Binding DataContext.PilihJawabanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="true" />
                            <Button Content="Salah" Padding="16,8"
                                    Command="{Binding DataContext.PilihJawabanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="false" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555">
                                <Run Text="Jawaban:" /><Run Text="{Binding JawabanAktif, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Essay / isian -->
                        <TextBox Text="{Binding JawabanAktif, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,14,0,0"
                                 Visibility="{Binding SoalAktif.IsEssay, Converter={StaticResource BoolToVisibility}}" />

                        <CheckBox Content="Ragu-ragu" IsChecked="{Binding RaguAktif, Mode=TwoWay}" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Submit" Padding="20,8" FontWeight="SemiBold"
                        Background="#2E7D32" Foreground="White" Command="{Binding SubmitCommand}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Sebelumnya" Padding="14,8" Margin="0,0,8,0" Command="{Binding PrevSoalCommand}" />
                    <Button Content="Berikutnya" Padding="14,8" Command="{Binding NextSoalCommand}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>

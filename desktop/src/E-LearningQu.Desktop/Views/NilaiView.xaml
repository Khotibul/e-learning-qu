<UserControl x:Class="E_LearningQu.Desktop.Views.NilaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="Content" Value="⟳  Muat ulang" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Memuat…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel>
                    <TextBlock Text="Nilai Pelajaran" Style="{StaticResource H1}" />
                    <TextBlock Text="Rekap nilai seluruh mata pelajaran semester berjalan."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Pesan error -->
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="12" Padding="14,11"
                    Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Tabel nilai -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Nilais}" Style="{StaticResource Grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mata Pelajaran" Binding="{Binding Mapel}" Width="*" />
                        <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="120" />
                        <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai}" Width="80" />
                        <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="150" />
                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="2*" />
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="E_LearningQu.Desktop.Views.NilaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Muat ulang" Padding="12,6"
                    Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
            <TextBlock Text="Nilai" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#C0392B" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
        <DataGrid ItemsSource="{Binding Nilais}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mapel" Binding="{Binding Mapel}" Width="*" />
                <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="100" />
                <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai}" Width="70" />
                <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="140" />
                <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="2*" />
                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM/yyyy}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

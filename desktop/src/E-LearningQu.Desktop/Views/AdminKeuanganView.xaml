<UserControl x:Class="E_LearningQu.Desktop.Views.AdminKeuanganView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1140">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer Margin="32,28,32,32" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Keuangan" Style="{StaticResource H1}" />
                    <TextBlock Text="Dashboard, verifikasi topup &amp; pembayaran, laporan akun, dan jurnal umum" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                        VerticalAlignment="Top" HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,18"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,14">
                <UniformGrid Columns="6">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.TopupMenunggu}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                        <TextBlock Text="Topup Menunggu" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.TagihanPending}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                        <TextBlock Text="Tagihan Pending" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.TotalSaldoDompet}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                        <TextBlock Text="Total Saldo Dompet" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.PendapatanKantin}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Pendapatan Kantin" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.TransaksiHariIni}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Transaksi Hari Ini" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Dashboard.InvoiceBelumLunas}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushError}" />
                        <TextBlock Text="Invoice Belum Lunas" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="16,12"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Antrean Topup" Style="{StaticResource SectionTitle}" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding AntreanTopup}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                                <DataGridTextColumn Header="Nomor" Binding="{Binding Nomor}" Width="*" />
                                <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="80" />
                                <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt}" Width="*" />
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#x2713;" Style="{StaticResource ButtonPillSuccess}"
                                                        Command="{Binding DataContext.SetujuiTopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Content="&#x2717;" Style="{StaticResource ButtonPillDanger}" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.TolakTopupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="16,12"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Pembayaran Tagihan" Style="{StaticResource SectionTitle}" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding AntreanPembayaran}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceKode}" Width="*" />
                                <DataGridTextColumn Header="Jenis" Binding="{Binding JenisNama}" Width="*" />
                                <DataGridTextColumn Header="Periode" Binding="{Binding Periode}" Width="80" />
                                <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80" />
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#x2713;" Style="{StaticResource ButtonPillSuccess}"
                                                        Command="{Binding DataContext.SetujuiPembayaranCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Content="&#x2717;" Style="{StaticResource ButtonPillDanger}" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.TolakPembayaranCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="4" Text="Laporan Akun" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <DataGrid Grid.Row="5" ItemsSource="{Binding Akun}" Style="{StaticResource Grid}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      MaxHeight="220" Margin="0,0,0,14"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90" />
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                    <DataGridTextColumn Header="Tipe" Binding="{Binding Tipe}" Width="*" />
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="*" />
                    <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Aktif}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6" Text="Jurnal Umum (50 terakhir)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <DataGrid Grid.Row="7" ItemsSource="{Binding Jurnal}" Style="{StaticResource Grid}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      MaxHeight="260"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
                    <DataGridTextColumn Header="Nomor" Binding="{Binding Nomor}" Width="110" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="3*" />
                    <DataGridTextColumn Header="Item" Binding="{Binding Item.Count}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>

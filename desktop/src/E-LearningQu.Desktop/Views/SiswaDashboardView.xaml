<UserControl x:Class="E_LearningQu.Desktop.Views.SiswaDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Muat ulang" Padding="12,6" Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Nama}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0" Foreground="#555" Text="{Binding Kelas}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Text="{Binding AiInsight}" Background="#EAF3FB" Padding="14" Margin="0,0,0,16"
                       TextWrapping="Wrap" FontSize="13"
                       Visibility="{Binding AiInsight, Converter={StaticResource NullToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Statistik}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="170" Margin="0,0,12,12" Padding="16" CornerRadius="8"
                                BorderThickness="1" BorderBrush="#E2E2E2" Background="#FAFBFC">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#666" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ujian berikutnya" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,4" />
            <TextBlock Text="{Binding NextUjianInfo}" Foreground="#333" Margin="0,0,0,12" />

            <TextBlock Text="Pengumuman" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
            <ItemsControl ItemsSource="{Binding Pengumuman}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="#F5F6F7">
                            <StackPanel>
                                <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Isi}" TextWrapping="Wrap" Foreground="#444" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#888" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ProgressBar Value="{Binding ProgresBelajar}" Maximum="100" Height="8" Margin="0,12,0,4" />
            <TextBlock FontSize="11" Foreground="#666" Text="{Binding ProgresBelajar, StringFormat=Progres belajar {0}%}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

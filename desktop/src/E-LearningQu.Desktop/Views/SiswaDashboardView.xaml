<UserControl x:Class="E_LearningQu.Desktop.Views.SiswaDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:views="clr-namespace:E_LearningQu.Desktop.Views">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Header sapaan -->
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="Content" Value="⟳  Muat ulang" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Memuat…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel>
                    <TextBlock Text="Assalamu'alaikum," Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="{Binding Nama}" Style="{StaticResource H1}" Margin="0,2,0,0" />
                    <Border Background="{StaticResource BrushSurfaceAlt}"
                            CornerRadius="20" Padding="12,5" HorizontalAlignment="Left" Margin="0,10,0,0"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏫" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding Kelas}" FontSize="12.5"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Pesan error -->
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="12" Padding="14,11"
                    Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Insight AI -->
            <Border Background="{StaticResource BrushInfoBg}" CornerRadius="14" Padding="16,14"
                    Margin="0,0,0,18" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    Visibility="{Binding AiInsight, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧠" FontSize="17" Margin="0,0,11,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Insight AI" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AiInsight}" FontSize="13"
                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kartu statistik -->
            <TextBlock Text="Ringkasan belajar" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Statistik}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:StatCardView DataContext="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ujian berikutnya -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource BrushAccent}"
                            VerticalAlignment="Center">
                        <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Ujian berikutnya" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding NextUjianInfo}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progres belajar -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Progres belajar" Style="{StaticResource StatLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ProgresBelajar, StringFormat={}{0}%}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgresBelajar}" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- Pengumuman -->
            <TextBlock Text="Pengumuman" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Pengumuman}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Border Background="{StaticResource BrushAccent}" CornerRadius="7"
                                            Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="📢" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               VerticalAlignment="Center" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Isi}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Panel kosong bila tak ada pengumuman -->
            <Border Style="{StaticResource CardAlt}" Margin="0,0,0,8"
                    Visibility="{Binding Pengumuman.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="Belum ada pengumuman terbaru." Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

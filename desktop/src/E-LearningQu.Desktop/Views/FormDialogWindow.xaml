<Window x:Class="E_LearningQu.Desktop.Views.FormDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="460" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontBody}">
    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            CornerRadius="16" Padding="26,22">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12"
                           Margin="0,0,0,16" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Batal" Style="{StaticResource ButtonGhost}"
                        MinWidth="96" Margin="0,0,10,0"
                        Click="OnCancel" IsCancel="True" />
                <Button Content="{Binding SaveText}" Style="{StaticResource ButtonPrimary}"
                        MinWidth="110" Click="OnSave" IsDefault="True" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FieldsPanel" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

<UserControl x:Class="E_LearningQu.Desktop.Views.AdminAbsensiGuruView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1140">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />

        <Style x:Key="PanelMonitoring" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelRekap" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelPengganti" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Absensi Guru" Style="{StaticResource H1}" />
                <TextBlock Text="Monitoring kehadiran, rekap, dan pengganti guru" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Monitoring" Style="{StaticResource ButtonGhost}" Command="{Binding PilihTabCommand}" CommandParameter="0" />
                <Button Content="Rekap" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" Command="{Binding PilihTabCommand}" CommandParameter="1" />
                <Button Content="Pengganti" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" Command="{Binding PilihTabCommand}" CommandParameter="2" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Tanggal (yyyy-MM-dd)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="120" Style="{StaticResource InputBox}" Text="{Binding SelectedTanggal, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <TextBox Width="220" Margin="10,0,0,0" Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" ToolTip="Cari guru/kelas/mapel" />
                <Button Content="Cari" Style="{StaticResource ButtonGhost}" Margin="10,0,0,0" Command="{Binding CariCommand}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <!-- MONITORING -->
        <Border Grid.Row="3" Style="{StaticResource PanelMonitoring}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,18"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <UniformGrid Columns="6">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Total}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Total Sesi" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Hadir}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Hadir" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Terlambat}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Terlambat" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Izin}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushInfo}" />
                            <TextBlock Text="Izin" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.TidakHadir}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushError}" />
                            <TextBlock Text="Tidak Hadir" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.BelumAbsen}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Belum Absen" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Monitoring}" Style="{StaticResource Grid}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Guru" Binding="{Binding GuruNama}" Width="2*" />
                        <DataGridTextColumn Header="Kelas" Binding="{Binding KelasNama}" Width="*" />
                        <DataGridTextColumn Header="Mapel" Binding="{Binding MataPelajaranNama}" Width="2*" />
                        <DataGridTextColumn Header="Jam" Binding="{Binding JamMulai}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        <DataGridTextColumn Header="Fase" Binding="{Binding Fase}" Width="80" />
                        <DataGridTextColumn Header="Masuk" Binding="{Binding JamMasuk}" Width="70" />
                        <DataGridTextColumn Header="Telat" Binding="{Binding TerlambatMenit}" Width="60" />
                        <DataGridTextColumn Header="Metode" Binding="{Binding Metode}" Width="*" />
                        <DataGridTextColumn Header="Pengganti" Binding="{Binding PenggantiNama}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- REKAP -->
        <Border Grid.Row="3" Style="{StaticResource PanelRekap}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,18"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="Total sesi: " /><Run Text="{Binding RekapTotal.TotalSesi, Mode=OneWay}" />
                        <Run Text="  •  Hadir: " /><Run Text="{Binding RekapTotal.Hadir, Mode=OneWay}" />
                        <Run Text="  •  Terlambat: " /><Run Text="{Binding RekapTotal.Terlambat, Mode=OneWay}" />
                        <Run Text="  •  Rata kehadiran: " /><Run Text="{Binding RekapTotal.RataKehadiranPersen, Mode=OneWay, StringFormat={}{0:0.#}%}" />
                    </TextBlock>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding RekapPerGuru}" Style="{StaticResource Grid}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Guru" Binding="{Binding GuruNama}" Width="2*" />
                        <DataGridTextColumn Header="Sesi" Binding="{Binding TotalSesi}" Width="60" />
                        <DataGridTextColumn Header="Hadir" Binding="{Binding Hadir}" Width="60" />
                        <DataGridTextColumn Header="Telat" Binding="{Binding Terlambat}" Width="60" />
                        <DataGridTextColumn Header="Izin" Binding="{Binding Izin}" Width="60" />
                        <DataGridTextColumn Header="Sakit" Binding="{Binding Sakit}" Width="60" />
                        <DataGridTextColumn Header="Alfa" Binding="{Binding TidakHadir}" Width="60" />
                        <DataGridTextColumn Header="Belum" Binding="{Binding BelumAbsen}" Width="60" />
                        <DataGridTextColumn Header="Rata %" Binding="{Binding RataKehadiranPersen, StringFormat={}{0:0.#}}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- PENGGANTI -->
        <Border Grid.Row="3" Style="{StaticResource PanelPengganti}">
            <DataGrid ItemsSource="{Binding Pengganti}" Style="{StaticResource Grid}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
                    <DataGridTextColumn Header="Guru Asli" Binding="{Binding AsliGuruNama}" Width="2*" />
                    <DataGridTextColumn Header="Pengganti" Binding="{Binding PenggantiNama}" Width="2*" />
                    <DataGridTextColumn Header="Kelas" Binding="{Binding KelasNama}" Width="*" />
                    <DataGridTextColumn Header="Mapel" Binding="{Binding MataPelajaranNama}" Width="2*" />
                    <DataGridTextColumn Header="Jam" Binding="{Binding JamMulai}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="Alasan" Binding="{Binding Alasan}" Width="2*" />
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hapus" Style="{StaticResource ButtonRowDanger}"
                                        Command="{Binding DataContext.HapusPenggantiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="E_LearningQu.Desktop.Views.SiswaAiAnalitikView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="AI Analitik" Style="{StaticResource H1}" />
                <TextBlock Text="Statistik dan riwayat analitik AI Anda" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Data, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <!-- Statistik -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="16" Padding="20"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Run" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Data.Statistik.TotalRuns}" Style="{StaticResource H1}" Foreground="{StaticResource BrushPrimary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sukses" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Data.Statistik.Sukses}" Style="{StaticResource H1}" Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gagal" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Data.Statistik.Gagal}" Style="{StaticResource H1}" Foreground="{StaticResource BrushError}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Riwayat -->
                <Border Background="{StaticResource BrushSurface}" CornerRadius="16" Padding="20"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Riwayat Analitik" Style="{StaticResource H3}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Data.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Tipe}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                            <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat=dd MMM HH:mm}" Style="{StaticResource Muted}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
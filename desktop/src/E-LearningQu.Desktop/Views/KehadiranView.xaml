<UserControl x:Class="E_LearningQu.Desktop.Views.KehadiranView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="Content" Value="⟳  Muat ulang" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Memuat…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel>
                    <TextBlock Text="Absensi &amp; Kehadiran" Style="{StaticResource H1}" />
                    <TextBlock Text="Pantau kehadiran dan ajukan izin sakit/izin khusus."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Pesan error -->
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="12" Padding="14,11"
                    Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Ringkasan kehadiran -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource BrushInfoBg}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RekapText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding HariIniText}" Margin="0,4,0,0" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form pengajuan absensi manual -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ajukan Absensi Manual" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="Pengajuan akan diverifikasi oleh admin / wali kelas."
                               Style="{StaticResource Muted}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tanggal (YYYY-MM-DD)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TanggalAjukan, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipe" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TipeOptions}" SelectedItem="{Binding TipeAjukan}"
                                      Padding="10,9" FontSize="14"
                                      Background="{StaticResource BrushSurface}"
                                      Foreground="{StaticResource BrushTextPrimary}"
                                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Alasan" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AlasanAjukan, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding AjukanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="Content" Value="Kirim Pengajuan" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding InfoAjukan}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushPrimary}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Riwayat bulan berjalan -->
            <TextBlock Text="Riwayat Bulan Berjalan" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource Grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Masuk" Binding="{Binding JamMasuk}" Width="90" />
                        <DataGridTextColumn Header="Status Masuk" Binding="{Binding StatusMasuk}" Width="130" />
                        <DataGridTextColumn Header="Pulang" Binding="{Binding JamPulang}" Width="90" />
                        <DataGridTextColumn Header="Terlambat (mnt)" Binding="{Binding TerlambatMenit}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pengajuan manual -->
            <TextBlock Text="Riwayat Pengajuan" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Permintaan}" Style="{StaticResource Grid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="120" />
                        <DataGridTextColumn Header="Tipe" Binding="{Binding Tipe}" Width="90" />
                        <DataGridTextColumn Header="Alasan" Binding="{Binding Alasan}" Width="2*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                        <DataGridTextColumn Header="Catatan Admin" Binding="{Binding CatatanAdmin}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="E_LearningQu.Desktop.Views.GuruDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:views="clr-namespace:E_LearningQu.Desktop.Views">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="Content" Value="⟳  Muat ulang" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Memuat…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel>
                    <TextBlock Text="Assalamu'alaikum," Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="Dashboard Guru" Style="{StaticResource H1}" Margin="0,2,0,0" />
                    <TextBlock Text="Pantau kelas, soal, dan perkembangan santri dalam satu tempat."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Pesan error -->
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="12" Padding="14,11"
                    Margin="0,0,0,14" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Kartu statistik -->
            <TextBlock Text="Ringkasan mengajar" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Statistik}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:StatCardView DataContext="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Panel empty-state bila tak ada data -->
            <Border Style="{StaticResource CardAlt}"
                    Visibility="{Binding Statistik.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,16">
                    <TextBlock Text="🕌" FontSize="30" HorizontalAlignment="Center" />
                    <TextBlock Text="Belum ada data untuk ditampilkan." FontSize="14"
                               Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Data akan muncul setelah kelas dan santri terdaftar." FontSize="12.5"
                               Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

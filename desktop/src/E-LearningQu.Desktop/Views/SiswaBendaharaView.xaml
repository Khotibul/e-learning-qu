<UserControl x:Class="E_LearningQu.Desktop.Views.SiswaBendaharaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Bendahara" Style="{StaticResource H1}" />
                <TextBlock Text="Kas kelas — pemasukan, pengeluaran, dan sisa kas" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <UniformGrid Columns="5" Margin="0,0,0,16">
            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,12,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Iuran" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Summary.PemasukanIuran, StringFormat={}{0:N0}}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,12,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Denda" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Summary.PemasukanDenda, StringFormat={}{0:N0}}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,12,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Pemasukan" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Summary.TotalPemasukan, StringFormat={}{0:N0}}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,12,0"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Pengeluaran" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Summary.TotalPengeluaran, StringFormat={}{0:N0}}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sisa Kas" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Summary.SisaKas, StringFormat={}{0:N0}}" Style="{StaticResource H2}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

    </Grid>
</UserControl>
<UserControl x:Class="E_LearningQu.Desktop.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E_LearningQu.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!-- ═══ Kartu statistik: putih bersih, hairline halus, ikon chip ═══ -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryLight}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource BrushInfoBg}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Margin" Value="0,13,0,0" />
        </Style>
        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <!-- ═══ Panel seksi (kehadiran, keuangan, distribusi, pengumuman) ═══ -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipOutline" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaCaps" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <!-- Angka besar pada tile ringkasan hari ini -->
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>

        <!-- Baris status kehadiran: label + meter tipis + angka -->
        <Style x:Key="MeterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeterValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Meter minimal: track lembut + indikator membulat, tanpa animasi bawaan -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryLight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3"
                                    Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tile kecil keuangan -->
        <Style x:Key="FinanceTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="FinanceValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Beranda Admin" Style="{StaticResource H1}" />
                <TextBlock Text="Ringkasan lengkap akademik, kehadiran, keuangan, dan pondok"
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource ChipOutline}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding HariIni}" Style="{StaticResource ChipText}" />
                    </StackPanel>
                </Border>

                <ProgressBar Width="70" Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                             Margin="0,0,10,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />

                <Button Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                        VerticalAlignment="Center" Content="Muat ulang" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ ERROR ═══════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,11"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                       FontSize="12.5" TextWrapping="Wrap" />
        </Border>

        <!-- ═══════════ ISI ═══════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ── Periode aktif ── -->
                <Border CornerRadius="18" Padding="24,20" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="0" />
                            <GradientStop Color="{StaticResource ColorPrimaryLight}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PERIODE AKTIF" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextOnDarkMuted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SemesterAktif}" FontFamily="{StaticResource FontDisplay}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextOnDark}" VerticalAlignment="Center" />
                                <Border Width="1" Height="14" Margin="12,0" VerticalAlignment="Center"
                                        Background="{StaticResource BrushTextOnDarkMuted}" Opacity="0.45" />
                                <TextBlock Text="{Binding TahunAjaranAktif}" FontSize="12.5"
                                           Foreground="{StaticResource BrushTextOnDarkMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Width="40" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushAccent}" Margin="0,14,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextOnDark}" HorizontalAlignment="Right" />
                            <TextBlock Text="Data ringkasan sistem" FontSize="11"
                                       Foreground="{StaticResource BrushTextOnDarkMuted}"
                                       HorizontalAlignment="Right" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ RINGKASAN HARI INI ═══ -->
                <TextBlock Text="Ringkasan Hari Ini" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                        VerticalAlignment="Center" Background="{StaticResource BrushSuccess}" />
                                <TextBlock Text="KEHADIRAN SANTRI" Style="{StaticResource MetaCaps}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding KehadiranSantriPersen}" Style="{StaticResource TileNumber}" />
                                <TextBlock Text="%" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SantriHadirInfo}" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource BrushBorder}" Margin="0,4,18,4" />

                        <StackPanel Grid.Column="2" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                        VerticalAlignment="Center" Background="{StaticResource BrushInfo}" />
                                <TextBlock Text="KEHADIRAN GURU" Style="{StaticResource MetaCaps}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="{Binding KehadiranGuruPersen}" Style="{StaticResource TileNumber}" />
                                <TextBlock Text="%" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,4"
                                           VerticalAlignment="Bottom"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GuruHadirInfo}" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="{StaticResource BrushBorder}" Margin="0,4,18,4" />

                        <StackPanel Grid.Column="4" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                        VerticalAlignment="Center" Background="{StaticResource BrushWarning}" />
                                <TextBlock Text="IZIN MENUNGGU" Style="{StaticResource MetaCaps}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Izin.Menunggu}" Style="{StaticResource TileNumber}"
                                       Margin="0,7,0,0" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="ajuan santri perlu ditinjau" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="5" Width="1" Background="{StaticResource BrushBorder}" Margin="0,4,18,4" />

                        <StackPanel Grid.Column="6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                        VerticalAlignment="Center" Background="{StaticResource BrushError}" />
                                <TextBlock Text="TERLAMBAT KEMBALI" Style="{StaticResource MetaCaps}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Izin.Terlambat}" Style="{StaticResource TileNumber}"
                                       Margin="0,7,0,0" Foreground="{StaticResource BrushError}" />
                            <TextBlock Text="{Binding TerlambatInfo}" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ DATA AKADEMIK ═══ -->
                <TextBlock Text="Data Akademik" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <UniformGrid Columns="4" Margin="0,0,0,8">

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalGuru}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Guru" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalSiswa}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Siswa" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE8A9;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalKelas}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Kelas" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalMapel}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Mata Pelajaran" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalSoal}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Bank Soal" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalUjian}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Ujian" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding Stats.TotalNilai}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Nilai Tersimpan" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <Border Style="{StaticResource IconChip}">
                                <TextBlock Text="&#xE715;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <TextBlock Text="{Binding TotalPengumuman}" Style="{StaticResource StatNumber}" />
                            <TextBlock Text="Pengumuman" Style="{StaticResource StatCaption}" />
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ═══ KEHADIRAN: SANTRI & GURU ═══ -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kehadiran santri -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Kehadiran Santri" Style="{StaticResource PanelTitle}" />
                                    <Border Style="{StaticResource ChipOutline}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Izin.TotalSantri, StringFormat={}{0} santri}"
                                                   Style="{StaticResource ChipText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Status hari ini" Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Di Pondok" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushSuccess}"
                                             Maximum="{Binding SantriTotalMax}" Value="{Binding Izin.DiPondok}" />
                                <TextBlock Grid.Column="2" Text="{Binding Izin.DiPondok}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Izin Aktif" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushInfo}"
                                             Maximum="{Binding SantriTotalMax}" Value="{Binding Izin.IzinAktif}" />
                                <TextBlock Grid.Column="2" Text="{Binding Izin.IzinAktif}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sedang Pulang" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushWarning}"
                                             Maximum="{Binding SantriTotalMax}" Value="{Binding Izin.SedangPulang}" />
                                <TextBlock Grid.Column="2" Text="{Binding Izin.SedangPulang}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Menunggu Izin" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushAccent}"
                                             Maximum="{Binding SantriTotalMax}" Value="{Binding Izin.Menunggu}" />
                                <TextBlock Grid.Column="2" Text="{Binding Izin.Menunggu}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Terlambat Kembali" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushError}"
                                             Maximum="{Binding SantriTotalMax}" Value="{Binding Izin.Terlambat}" />
                                <TextBlock Grid.Column="2" Text="{Binding Izin.Terlambat}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4,0,10" />
                            <TextBlock Style="{StaticResource MetaText}">
                                <Run Text="Total " /><Run Text="{Binding Izin.TotalSantri, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" santri terdaftar di pondok" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Absensi guru -->
                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Absensi Guru" Style="{StaticResource PanelTitle}" />
                                    <Border Style="{StaticResource ChipOutline}" Margin="10,0,0,0"
                                            Visibility="{Binding AbsensiTanggal, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="{Binding AbsensiTanggal}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding AbsensiGuru.Total, StringFormat={}{0} sesi}"
                                           Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hadir" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushSuccess}"
                                             Maximum="{Binding GuruTotalMax}" Value="{Binding AbsensiGuru.Hadir}" />
                                <TextBlock Grid.Column="2" Text="{Binding AbsensiGuru.Hadir}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Terlambat" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushWarning}"
                                             Maximum="{Binding GuruTotalMax}" Value="{Binding AbsensiGuru.Terlambat}" />
                                <TextBlock Grid.Column="2" Text="{Binding AbsensiGuru.Terlambat}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Izin" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushInfo}"
                                             Maximum="{Binding GuruTotalMax}" Value="{Binding AbsensiGuru.Izin}" />
                                <TextBlock Grid.Column="2" Text="{Binding AbsensiGuru.Izin}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sakit" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushBorderStrong}"
                                             Maximum="{Binding GuruTotalMax}" Value="{Binding AbsensiGuru.Sakit}" />
                                <TextBlock Grid.Column="2" Text="{Binding AbsensiGuru.Sakit}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tidak Hadir" Style="{StaticResource MeterLabel}" />
                                <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Margin="0,0,12,0"
                                             Foreground="{StaticResource BrushError}"
                                             Maximum="{Binding GuruTotalMax}" Value="{Binding AbsensiGuru.TidakHadir}" />
                                <TextBlock Grid.Column="2" Text="{Binding AbsensiGuru.TidakHadir}" Style="{StaticResource MeterValue}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4,0,10" />
                            <TextBlock Text="{Binding BelumAbsenInfo}" Style="{StaticResource MetaText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ KEUANGAN ═══ -->
                <TextBlock Text="Ringkasan Keuangan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Bendahara &amp; Dompet Santri" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Angka terkini" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="TOPUP MENUNGGU" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding Keuangan.TopupMenunggu}" Style="{StaticResource FinanceValue}"
                                               Foreground="{StaticResource BrushWarning}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="TAGIHAN PENDING" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding Keuangan.TagihanPending}" Style="{StaticResource FinanceValue}"
                                               Foreground="{StaticResource BrushWarning}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="INVOICE BELUM LUNAS" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding Keuangan.InvoiceBelumLunas}" Style="{StaticResource FinanceValue}"
                                               Foreground="{StaticResource BrushError}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="SALDO DOMPET" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding SaldoDompetRupiah}" Style="{StaticResource FinanceValue}"
                                               Foreground="{StaticResource BrushSuccess}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="PENDAPATAN KANTIN" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding PendapatanKantinRupiah}" Style="{StaticResource FinanceValue}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FinanceTile}">
                                <StackPanel>
                                    <TextBlock Text="TRANSAKSI HARI INI" Style="{StaticResource MetaCaps}" />
                                    <TextBlock Text="{Binding Keuangan.TransaksiHariIni}" Style="{StaticResource FinanceValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ DISTRIBUSI AKADEMIK ═══ -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Sebaran Siswa per Kelas" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Enam kelas terbesar" Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PerKelas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MeterLabel}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,70,0" />
                                                <TextBlock Text="{Binding Nilai, StringFormat={}{0} siswa}"
                                                           Style="{StaticResource MetaText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource Meter}" Margin="0,6,0,0"
                                                         Value="{Binding Nilai}"
                                                         Maximum="{Binding DataContext.MaxPerKelas, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource CardAlt}" Padding="14,12"
                                    Visibility="{Binding PerKelas.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="Belum ada data kelas." Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Nilai per Mapel" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Enam mapel terbesar" Style="{StaticResource MetaText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PerMapel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MeterLabel}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,70,0" />
                                                <TextBlock Text="{Binding Nilai, StringFormat={}{0} nilai}"
                                                           Style="{StaticResource MetaText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource Meter}" Margin="0,6,0,0"
                                                         Value="{Binding Nilai}"
                                                         Maximum="{Binding DataContext.MaxPerMapel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource CardAlt}" Padding="14,12"
                                    Visibility="{Binding PerMapel.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="Belum ada data mata pelajaran." Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ PENGUMUMAN TERBARU ═══ -->
                <TextBlock Text="Pengumuman Terbaru" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Terbaru dari admin" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding TotalPengumuman, StringFormat={}{0} pengumuman}"
                                       Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PengumumanTerbaru}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                                            Padding="0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                                                    Background="{StaticResource BrushInfoBg}" VerticalAlignment="Top">
                                                <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{StaticResource BrushPrimary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Judul}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Isi}" FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding User.Name}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding User.Name, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ChipOutline}"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding Tipe, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Tipe}" Style="{StaticResource ChipText}"
                                                           FontSize="10.5" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardAlt}" Padding="14,12"
                                Visibility="{Binding PengumumanTerbaru.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="Belum ada pengumuman." Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

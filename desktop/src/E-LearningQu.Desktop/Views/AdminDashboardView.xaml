<UserControl x:Class="E_LearningQu.Desktop.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Beranda Admin" Style="{StaticResource H1}" />
                <TextBlock Text="Ringkasan data sistem e-learning" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE939;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalGuru}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Guru" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE939;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalSiswa}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Siswa" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalKelas}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Kelas" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,0,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalMapel}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Mata Pelajaran" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalSoal}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Total Soal" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalUjian}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Total Ujian" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16" Margin="0,0,14,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="24"  Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="{Binding Stats.TotalNilai}" Style="{StaticResource H2}" Margin="0,8,0,0" />
                        <TextBlock Text="Nilai Tersimpan" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
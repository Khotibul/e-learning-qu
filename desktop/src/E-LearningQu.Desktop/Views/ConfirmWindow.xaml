<Window x:Class="E_LearningQu.Desktop.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E_LearningQu.Desktop.Controls"
        Title="{Binding DialogTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontBody}">
    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            CornerRadius="18" Padding="26,24,26,20">
        <StackPanel>
            <Border Width="44" Height="44" CornerRadius="22"
                    Background="{StaticResource BrushWarningBg}"
                    HorizontalAlignment="Left" Margin="0,0,0,14">
                <TextBlock Text="!" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushWarning}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H2}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,18" />

            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Style="{StaticResource ButtonGhost}"
                        MinWidth="96" Margin="0,0,10,0"
                        Click="OnCancel" IsCancel="True" />
                <Button Content="{Binding ConfirmText}" Style="{StaticResource ButtonPrimary}"
                        MinWidth="120" Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

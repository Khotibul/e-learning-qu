<UserControl x:Class="E_LearningQu.Desktop.Views.GuruNilaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
    </UserControl.Resources>
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Nilai" Style="{StaticResource H1}" /><TextBlock Text="Daftar ujian dan hasil nilai siswa" Style="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}" VerticalAlignment="Top" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>
        <Grid Grid.Row="2">
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
            </Border>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding Ujians.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Ujian" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Ujians}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="10" Padding="14,10" Margin="0,0,10,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" MinWidth="180">
                                    <StackPanel><TextBlock Text="{Binding Nama}" FontWeight="SemiBold" /><TextBlock Text="{Binding MataPelajaran.Nama}" Style="{StaticResource Muted}" Margin="0,2,0,0" /><TextBlock Text="{Binding Kelas.Nama}" Style="{StaticResource Muted}" /></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Nilais}" Style="{StaticResource Grid}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding Nilais.Count, Converter={StaticResource CountToVisibility}}" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Siswa" Binding="{Binding Siswa.Nama}" Width="2*" />
                        <DataGridTextColumn Header="Ujian" Binding="{Binding Ujian.Nama}" Width="2*" />
                        <DataGridTextColumn Header="Nilai" Binding="{Binding Nilai}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
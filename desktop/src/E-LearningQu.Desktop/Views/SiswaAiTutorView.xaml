<UserControl x:Class="E_LearningQu.Desktop.Views.SiswaAiTutorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="AI Tutor" Style="{StaticResource H1}" />
                <TextBlock Text="Tanyakan materi pelajaran kepada tutor AI" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                <ComboBox Width="180" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Mapels}" SelectedItem="{Binding SelectedMapel}"
                          DisplayMemberPath="Nama" ToolTip="Pilih mata pelajaran" />
                <Button Content="Sesi Baru" Style="{StaticResource ButtonGhost}" Command="{Binding NewSessionCommand}" Margin="0,0,10,0" />
                <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="12"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sesi Percakapan" Style="{StaticResource H2}" Margin="6,4,6,10" />
                    <ListBox ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="OnSessionDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Judul}" TextTrimming="CharacterEllipsis" Style="{StaticResource TextBase}" />
                                    <TextBlock Text="{Binding Count.Messages, StringFormat={}{0} pesan}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="16"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10">
                                    <Border CornerRadius="10" Padding="12,9" MaxWidth="640"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource BrushSurface}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" Style="{StaticResource Muted}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Konten}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    </Border>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="🤖" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Mulai percakapan" Style="{StaticResource H2}" Margin="0,12,0,4" HorizontalAlignment="Center" />
                            <TextBlock Text="Ajukan pertanyaan tentang materi pelajaranmu" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="InputBox" Height="44" VerticalContentAlignment="Center"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnInputKeyDown"
                             ToolTip="Ketik pertanyaan lalu tekan Enter" />
                    <Button Grid.Column="2" Content="Kirim" Height="44" MinWidth="90"
                            Command="{Binding SendCommand}"
                            IsEnabled="{Binding IsSending, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
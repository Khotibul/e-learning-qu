<UserControl x:Class="E_LearningQu.Desktop.Views.AdminFingerprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1140">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style x:Key="PanelPerangkat" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelMonitoring" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelEvents" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelPermintaan" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Fingerprint &amp; Absensi Harian" Style="{StaticResource H1}" />
                <TextBlock Text="Perangkat, pemetaan sidik jari, monitoring harian, dan permintaan manual" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Perangkat" Style="{StaticResource ButtonGhost}" Command="{Binding PilihTabCommand}" CommandParameter="0" />
                <Button Content="Monitoring" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" Command="{Binding PilihTabCommand}" CommandParameter="1" />
                <Button Content="Event" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" Command="{Binding PilihTabCommand}" CommandParameter="2" />
                <Button Content="Permintaan" Style="{StaticResource ButtonGhost}" Margin="8,0,0,0" Command="{Binding PilihTabCommand}" CommandParameter="3" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Tanggal (yyyy-MM-dd)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="120" Style="{StaticResource InputBox}" Text="{Binding MonitoringTanggal, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <TextBox Width="200" Margin="10,0,0,0" Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" ToolTip="Cari siswa (NIS/nama)" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <!-- PERANGKAT + PEMETAAN -->
        <Border Grid.Row="3" Style="{StaticResource PanelPerangkat}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,14"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tambah perangkat:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="180" Style="{StaticResource InputBox}" Text="{Binding TambahNama, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" ToolTip="Nama perangkat" />
                            <TextBox Width="180" Margin="8,0,0,0" Style="{StaticResource InputBox}" Text="{Binding TambahLokasi, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" ToolTip="Lokasi (opsional)" />
                            <Button Content="Buat Perangkat" Style="{StaticResource ButtonPrimary}" Margin="8,0,0,0" Command="{Binding TambahPerangkatCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ApiKeyBaru, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="API key baru (tampil sekali):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="360" IsReadOnly="True" Style="{StaticResource InputBox}" Text="{Binding ApiKeyBaru, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding Perangkat}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" MouseDoubleClick="OnPerangkatDoubleClick"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90" />
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                            <DataGridTextColumn Header="Lokasi" Binding="{Binding Lokasi}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="Siswa" Binding="{Binding JumlahSiswa}" Width="60" />
                            <DataGridTextColumn Header="Scan" Binding="{Binding ScanHariIni}" Width="60" />
                            <DataGridTextColumn Header="Terakhir" Binding="{Binding LastSeenAt}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Peta" Style="{StaticResource ButtonRow}"
                                                    Command="{Binding DataContext.PilihPerangkatCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Status" Style="{StaticResource ButtonRow}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Key" Style="{StaticResource ButtonRow}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RotasiKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Hapus" Style="{StaticResource ButtonRowDanger}" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.HapusPerangkatCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="16,12"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="Pemetaan — " /><Run Text="{Binding SelectedPerangkat.Nama, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBox Width="130" Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" ToolTip="Cari siswa" />
                                <Button Content="Cari" Style="{StaticResource ButtonGhost}" Margin="6,0,0,0" Command="{Binding CariSiswaCommand}" VerticalAlignment="Center" />
                                <ComboBox Width="150" Margin="6,0,0,0" Style="{StaticResource InputCombo}" VerticalAlignment="Center"
                                          ItemsSource="{Binding HasilCari}" SelectedItem="{Binding SiswaTerpilih}"
                                          DisplayMemberPath="Nama" />
                                <TextBox Width="70" Margin="6,0,0,0" Style="{StaticResource InputBox}" Text="{Binding UidBaru, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" ToolTip="UID sidik jari" />
                                <Button Content="Petakan" Style="{StaticResource ButtonPrimary}" Margin="6,0,0,0" Command="{Binding TambahPemetaanCommand}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding Pemetaan}" Style="{StaticResource Grid}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                                    <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                                    <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="*" />
                                    <DataGridTextColumn Header="UID" Binding="{Binding PerangkatUserId}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Hapus" Style="{StaticResource ButtonRowDanger}"
                                                        Command="{Binding DataContext.HapusPemetaanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- MONITORING HARIAN -->
        <Border Grid.Row="3" Style="{StaticResource PanelMonitoring}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,18"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <UniformGrid Columns="5">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.TotalSiswa}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Total Siswa" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Masuk}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Masuk" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.BelumMasuk}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushError}" />
                            <TextBlock Text="Belum Masuk" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Terlambat}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Terlambat" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Ringkasan.Pulang}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushInfo}" />
                            <TextBlock Text="Sudah Pulang" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Monitoring}" Style="{StaticResource Grid}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                        <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                        <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="*" />
                        <DataGridTextColumn Header="Masuk" Binding="{Binding JamMasuk}" Width="70" />
                        <DataGridTextColumn Header="Pulang" Binding="{Binding JamPulang}" Width="70" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusMasuk}" Width="*" />
                        <DataGridTextColumn Header="Telat" Binding="{Binding TerlambatMenit}" Width="60" />
                        <DataGridTextColumn Header="Perangkat" Binding="{Binding PerangkatMasuk}" Width="*" />
                        <DataGridTextColumn Header="Alasan" Binding="{Binding KoreksiAlasan}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- EVENTS -->
        <Border Grid.Row="3" Style="{StaticResource PanelEvents}">
            <DataGrid ItemsSource="{Binding Events}" Style="{StaticResource Grid}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Waktu" Binding="{Binding ServerAt}" Width="*" />
                    <DataGridTextColumn Header="Perangkat" Binding="{Binding Perangkat}" Width="*" />
                    <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="80" />
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                    <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                    <DataGridTextColumn Header="Tipe" Binding="{Binding Tipe}" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="Pesan" Binding="{Binding Pesan}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- PERMINTAAN MANUAL -->
        <Border Grid.Row="3" Style="{StaticResource PanelPermintaan}">
            <DataGrid ItemsSource="{Binding Permintaan}" Style="{StaticResource Grid}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                    <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                    <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="*" />
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
                    <DataGridTextColumn Header="Tipe" Binding="{Binding Tipe}" Width="80" />
                    <DataGridTextColumn Header="Alasan" Binding="{Binding Alasan}" Width="2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Setujui" Style="{StaticResource ButtonPillSuccess}"
                                            Command="{Binding DataContext.SetujuiPermintaanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}" />
                                    <Button Content="Tolak" Style="{StaticResource ButtonPillDanger}" Margin="4,0,0,0"
                                            Command="{Binding DataContext.TolakPermintaanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

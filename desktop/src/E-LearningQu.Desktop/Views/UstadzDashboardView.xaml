<UserControl x:Class="E_LearningQu.Desktop.Views.UstadzDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="740" d:DesignWidth="1120">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Ustadz / Ustadzah" Style="{StaticResource H1}" />
                <TextBlock Text="Kelas diniyah, halaqah tahfidz, dan laporan binaan" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Kelas diniyah saya -->
            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kelas Diniyah Saya" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding KelasSaya}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200"
                              Visibility="{Binding KelasSaya.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kelas" Binding="{Binding Nama}" Width="2*" />
                            <DataGridTextColumn Header="Tingkat" Binding="{Binding Tingkat}" Width="*" />
                            <DataGridTextColumn Header="Hari" Binding="{Binding Hari}" Width="*" />
                            <DataGridTextColumn Header="Jam" Binding="{Binding Jam}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Halaqah saya -->
            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Halaqah Tahfidz" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HalaqahSaya}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200"
                              Visibility="{Binding HalaqahSaya.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Halaqah" Binding="{Binding Nama}" Width="2*" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetSurah}" Width="*" />
                            <DataGridTextColumn Header="Santri" Binding="{Binding JumlahSantri}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Setoran terbaru -->
            <Border Grid.Column="0" Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Setoran Terbaru" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SetoranTerbaru}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Visibility="{Binding SetoranTerbaru.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Santri" Binding="{Binding Nama}" Width="2*" />
                            <DataGridTextColumn Header="Halaqah" Binding="{Binding Halaqah}" Width="*" />
                            <DataGridTextColumn Header="Surah" Binding="{Binding Surah}" Width="*" />
                            <DataGridTextColumn Header="Ayat" Binding="{Binding Ayat}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Tgl" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Laporan -->
            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Laporan Bulan Berjalan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding Laporan.RataTajwid}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushInfo}" />
                            <TextBlock Text="Rata Tajwid" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding Laporan.RataKelancaran}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Rata Kelancaran" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Laporan.JumlahDinilai}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Jumlah Dinilai" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding LaporanBar}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Visibility="{Binding LaporanBar.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Indikator" Binding="{Binding Label}" Width="3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

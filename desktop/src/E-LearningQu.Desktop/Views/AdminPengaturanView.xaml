<UserControl x:Class="E_LearningQu.Desktop.Views.AdminPengaturanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Pengaturan Situs" Style="{StaticResource H1}" />
                <TextBlock Text="Identitas situs, logo/favicon, tentang kami, dan fitur landing" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Content="Simpan" Style="{StaticResource ButtonPrimary}" Command="{Binding SimpanConfigCommand}" Margin="0,0,8,0" />
                <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Identitas -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,20"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Identitas Situs" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="Nama Situs" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Tagline" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Deskripsi" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Judul Tentang Kami" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" Text="{Binding AboutTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Isi Tentang Kami" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                                 Text="{Binding AboutText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="URL Logo" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10" Text="{Binding LogoUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="URL Favicon" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Text="{Binding FaviconUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fitur landing -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,20"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fitur Landing" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource InputBox}" Margin="0,0,0,6" Text="{Binding FeatureTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,0,0,6" Text="{Binding FeatureDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel>
                            <TextBox Style="{StaticResource InputBox}" DockPanel.Dock="Left" Margin="0,0,8,0"
                                     Text="{Binding FeatureIcon, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Tambah" Style="{StaticResource ButtonPrimary}" Command="{Binding TambahFiturCommand}" />
                        </DockPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <TextBlock Text="Klik hapus untuk menghapus fitur. Urutan mengikuti nomor di kolom Order." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Border>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Features}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Visibility="{Binding Features.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Icon" Binding="{Binding Icon}" Width="*" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="50" />
                            <DataGridTextColumn Header="Aktif" Binding="{Binding IsActive}" Width="60" />
                            <DataGridTemplateColumn Header="Aksi" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Hapus" Style="{StaticResource ButtonGhost}" Padding="8,3" FontSize="11"
                                                Command="{Binding DataContext.HapusFiturCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

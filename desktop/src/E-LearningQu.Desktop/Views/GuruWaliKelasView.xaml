<UserControl x:Class="E_LearningQu.Desktop.Views.GuruWaliKelasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Wali Kelas" Style="{StaticResource H1}" />
                <TextBlock Text="Struktur dan daftar siswa kelas yang Anda bina" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="16" Padding="32,40"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🛡" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Text="Anda belum menjadi wali kelas" Style="{StaticResource H2}" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="Penetapan wali kelas dilakukan oleh admin sekolah" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="12"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kelas Binaan" Style="{StaticResource H2}" Margin="6,4,6,10" />
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedKelas, Mode=OneWay}"
                             SelectionChanged="OnKelasSelected" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Nama}" Style="{StaticResource TextBase}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Count.Siswas, StringFormat={}{0} siswa}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Daftar Siswa" Style="{StaticResource H2}" Margin="4,0,4,12" />
                    <DataGrid ItemsSource="{Binding Siswa}" Style="{StaticResource Grid}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Visibility="{Binding Siswa.Count, Converter={StaticResource CountToVisibility}}"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="3*" />
                            <DataGridTextColumn Header="NIS" Binding="{Binding Nis}" Width="*" />
                            <DataGridTextColumn Header="Jabatan" Binding="{Binding Jabatan}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
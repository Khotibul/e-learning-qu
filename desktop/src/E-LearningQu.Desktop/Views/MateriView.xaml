<UserControl x:Class="E_LearningQu.Desktop.Views.MateriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                            <Setter Property="Content" Value="⟳  Muat ulang" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Memuat…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel>
                    <TextBlock Text="Materi Pelajaran" Style="{StaticResource H1}" />
                    <TextBlock Text="Akses materi, modul, dan lampiran yang dibagikan guru."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Pesan error -->
            <Border Background="{StaticResource BrushErrorBg}" CornerRadius="12" Padding="14,11"
                    Margin="0,0,0,12" BorderBrush="{StaticResource BrushError}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Daftar materi -->
            <ListBox ItemsSource="{Binding Materis}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource BrushInfoBg}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding MataPelajaran.Nama}" FontSize="12.5"
                                               Foreground="{StaticResource BrushPrimary}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Deskripsi}" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding FileUrl}" Foreground="{StaticResource BrushPrimary}"
                                               FontSize="11.5" Margin="0,6,0,0" TextDecorations="Underline"
                                               Visibility="{Binding FileUrl, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <Border Style="{StaticResource CardAlt}"
                    Visibility="{Binding Materis.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,16">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center"  Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="Belum ada materi yang dibagikan." FontSize="14"
                               Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

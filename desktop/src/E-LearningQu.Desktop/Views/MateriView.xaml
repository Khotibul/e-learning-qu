<UserControl x:Class="E_LearningQu.Desktop.Views.MateriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Muat ulang" Padding="12,6"
                    Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
            <TextBlock Text="Materi" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#C0392B" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
        <ListBox ItemsSource="{Binding Materis}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" BorderBrush="#E2E2E2" BorderThickness="1" Background="White">
                        <StackPanel>
                            <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MataPelajaran.Nama}" Foreground="#5B7C99" FontSize="12" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Deskripsi}" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FileUrl}" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding FileUrl, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

<UserControl x:Class="E_LearningQu.Desktop.Views.KepalaPondokKeuanganView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Keuangan Pondok" Style="{StaticResource H1}" />
                <TextBlock Text="Rekap tagihan unit pondok, tunggakan, topup, dan kantin" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushErrorBg}" CornerRadius="10" Padding="14,12"
                BorderBrush="{StaticResource BrushError}" BorderThickness="1" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="24,20"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Rekap Tagihan Pondok" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Data.TopupBerhasil.Jumlah}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushSuccess}" />
                            <TextBlock Text="Total Topup Berhasil" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Data.TransaksiKantin.Jumlah}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Transaksi Kantin" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Rekap.Count}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Status Tagihan" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Tunggakan.Count}" Style="{StaticResource StatValue}" Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Tunggakan" Style="{StaticResource StatLabel}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Per Status Tagihan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rekap}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding Rekap.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="*" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="*" />
                                <DataGridTextColumn Header="Sisa" Binding="{Binding Sisa, StringFormat={}{0:N0}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tunggakan" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tunggakan}" Style="{StaticResource Grid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Visibility="{Binding Tunggakan.Count, Converter={StaticResource CountToVisibility}}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                                <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="*" />
                                <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="*" />
                                <DataGridTextColumn Header="Periode" Binding="{Binding Periode}" Width="*" />
                                <DataGridTextColumn Header="Sisa" Binding="{Binding Sisa, StringFormat={}{0:N0}}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

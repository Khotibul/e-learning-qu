<UserControl x:Class="E_LearningQu.Desktop.Views.AdminPpdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:E_LearningQu.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1140">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="BusyToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="PPDB" Style="{StaticResource H1}" />
                <TextBlock Text="Penerimaan Peserta Didik Baru — gelombang &amp; jalur" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Muat Ulang" Style="{StaticResource ButtonGhost}" Command="{Binding LoadCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <ProgressBar Width="110" Height="4" IsIndeterminate="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BusyToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nama Gelombang" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Nama}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tahun Ajaran" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding TahunAjaranOptions}" SelectedValuePath="Id" DisplayMemberPath="Nama"
                                  SelectedValue="{Binding SelectedTahunAjaranId}" Style="{StaticResource InputCombo}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Tgl Buka" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding TanggalBuka}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Tgl Tutup" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding TanggalTutup}" />
                    </StackPanel>
                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <Button Content="Tambah" Style="{StaticResource ButtonPrimary}" Command="{Binding TambahCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}" CornerRadius="14" Padding="20,16"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource Grid}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}}"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="2*" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                        <DataGridTextColumn Header="Tahun Ajaran" Binding="{Binding TahunAjaran.Nama}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        <DataGridTextColumn Header="Buka" Binding="{Binding TanggalBuka, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                        <DataGridTextColumn Header="Tutup" Binding="{Binding TanggalTutup, StringFormat={}{0:dd/MM/yyyy}}" Width="*" />
                        <DataGridTextColumn Header="Jalur" Binding="{Binding Jalur.Count}" Width="Auto" />
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Hapus" Style="{StaticResource ButtonGhost}" Padding="6,2"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

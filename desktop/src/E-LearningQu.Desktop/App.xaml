<Application x:Class="E_LearningQu.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette di-merge DULUAN supaya StaticResource styles di bawah ini bisa resolve -->
                <ResourceDictionary Source="Themes/PaletteLight.xaml" />
                <ResourceDictionary Source="Themes/GridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ================= Design Tokens: Spacing (skala 4) ================= -->
        <Thickness x:Key="SpacingXs" Left="4" Top="4" Right="4" Bottom="4" />
        <Thickness x:Key="SpacingSm" Left="8" Top="8" Right="8" Bottom="8" />
        <Thickness x:Key="SpacingMd" Left="12" Top="12" Right="12" Bottom="12" />
        <Thickness x:Key="SpacingLg" Left="16" Top="16" Right="16" Bottom="16" />
        <Thickness x:Key="SpacingXl" Left="24" Top="24" Right="24" Bottom="24" />
        <Thickness x:Key="Spacing2Xl" Left="32" Top="32" Right="32" Bottom="32" />

        <!-- ================= Design Tokens: Radius ================= -->
        <CornerRadius x:Key="RadiusSm" TopLeft="6" TopRight="6" BottomLeft="6" BottomRight="6" />
        <CornerRadius x:Key="RadiusMd" TopLeft="10" TopRight="10" BottomLeft="10" BottomRight="10" />
        <CornerRadius x:Key="RadiusLg" TopLeft="16" TopRight="16" BottomLeft="16" BottomRight="16" />
        <CornerRadius x:Key="RadiusFull" TopLeft="999" TopRight="999" BottomLeft="999" BottomRight="999" />

        <!-- ================= Design Tokens: Tipografi ================= -->
        <FontFamily x:Key="FontBody">Segoe UI, Noto Naskh Arabic, Tahoma</FontFamily>
        <FontFamily x:Key="FontDisplay">Segoe UI Semibold, Segoe UI</FontFamily>
        <sys:Double x:Key="FontSizeXs">11</sys:Double>
        <sys:Double x:Key="FontSizeSm">12</sys:Double>
        <sys:Double x:Key="FontSizeMd">14</sys:Double>
        <sys:Double x:Key="FontSizeLg">16</sys:Double>
        <sys:Double x:Key="FontSizeXl">18</sys:Double>
        <sys:Double x:Key="FontSize2Xl">24</sys:Double>
        <sys:Double x:Key="FontSize3Xl">26</sys:Double>

        <!-- ================= TextBlock ================= -->
        <Style TargetType="TextBlock" x:Key="TextBase">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />

        <Style TargetType="TextBlock" x:Key="H1">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize3Xl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="H2">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="H3">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryDark}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Muted">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="StatValue">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize2Xl}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryDark}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="StatLabel">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- ================= Buttons ================= -->
        <Style TargetType="Button" x:Key="ButtonPrimary">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryLight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ButtonAccent">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryDark}" />
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDark}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol netral (Ghost) -->
        <Style TargetType="Button" x:Key="ButtonGhost">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol berbahaya (hapus / keluar) -->
        <Style TargetType="Button" x:Key="ButtonDanger">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushError}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushErrorBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushError}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol keluar (di sidebar gelap): solid merah supaya menonjol -->
        <Style TargetType="Button" x:Key="ButtonLogout">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource BrushError}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C43A32" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8E1C16" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol Google (putih, border tipis) -->
        <Style TargetType="Button" x:Key="ButtonGoogle">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TextBox ================= -->
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimaryLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ComboBox ================= -->
        <Style TargetType="ComboBox" x:Key="InputCombo">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0" />
                                <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Fill="{StaticResource BrushTextSecondary}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0" />
                                <ToggleButton Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup Grid.ColumnSpan="2" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}" Margin="0,4,0,0" Padding="0,6"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimaryLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= PasswordBox ================= -->
        <Style TargetType="PasswordBox" x:Key="InputPassword">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Card / Panel ================= -->
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style TargetType="Border" x:Key="CardAlt">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- ================= ProgressBar (pakai template default, warna tema) ================= -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryLight}" />
            <Setter Property="Background" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- ================= ListBox (sidebar menu) ================= -->
        <Style TargetType="ListBoxItem" x:Key="SidebarItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTextOnDarkMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}"
                                Margin="10,2" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ScrollBar (ramping, emas) ================= -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource BrushBorder}" CornerRadius="5" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ToolTip ================= -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Background" Value="{StaticResource BrushPrimaryDark}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

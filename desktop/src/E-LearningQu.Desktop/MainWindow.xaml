<Window x:Class="E_LearningQu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:E_LearningQu.Desktop"
        Title="E-Learning-Qu — Pondok Pesantren Digital"
        Width="1220" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- ==================== SHELL (setelah login) ==================== -->
        <Grid x:Name="ShellHost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar kiri: gradasi hijau pesantren -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="0" />
                        <GradientStop Color="{StaticResource ColorSidebar}" Offset="0.6" />
                        <GradientStop Color="#072A1A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="True">

                    <!-- Header brand + user -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                    <!-- Baris brand + tombol lipat sidebar -->
                    <Border Background="Transparent" Cursor="Hand" ToolTip="Lipat / buka sidebar"
                            MouseLeftButtonDown="OnToggleSidebar">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource BrushAccent}"
                                    VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/logo.png" Width="34" Height="34"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel x:Name="SidebarText" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="E-Learning-Qu" Foreground="{StaticResource BrushTextOnDark}"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Pondok Pesantren Digital" Foreground="{StaticResource BrushAccent}"
                                           FontSize="10.5" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CollapseGlyph" Text="«" FontSize="14" Foreground="#5CA87B"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>

                        <!-- Kartu profil -->
                        <Border Background="#14684314" CornerRadius="12" Padding="12" Margin="0,16,0,0"
                                BorderBrush="#2A8A5C33" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource BrushAccent}">
                                    <TextBlock x:Name="AvatarText" Text="?" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimaryDark}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="UserLabel" Foreground="{StaticResource BrushTextOnDark}"
                                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="RoleLabel" Foreground="{StaticResource BrushTextOnDarkMuted}"
                                               FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ornamen pemisah (gaya kaligrafi) -->
                        <Border Height="1" Background="#22C9A227" Margin="0,14,0,6" />
                        <TextBlock Text="MENU" Foreground="#5CA87B" FontSize="10" FontWeight="SemiBold"
                                   Margin="12,0,0,6" />
                    </StackPanel>

                    <!-- Cari menu -->
                    <Border DockPanel.Dock="Top" Margin="16,0,16,8">
                        <TextBox x:Name="MenuSearchBox" Style="{StaticResource InputBox}"
                                 Padding="10,8" FontSize="12.5"
                                 TextChanged="OnMenuSearchChanged"
                                 ToolTip="Ketik untuk menyaring menu" />
                    </Border>

                    <!-- Tombol keluar -->
                    <Border DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#6B7280" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnLabel" Text="Memeriksa koneksi…" Foreground="#5CA87B" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="LogoutButton" Click="OnLogout" HorizontalAlignment="Stretch"
                                Style="{StaticResource ButtonLogout}">
                                <TextBlock>
                                    <Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" />
                                    <Run Text="  Keluar" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Menu navigasi -->
                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnMenuSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             Padding="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" Width="26"
                                               VerticalAlignment="Center" />
                                     <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- Konten utama -->
            <Border Grid.Column="1" Background="{StaticResource BrushCanvas}">
                <ContentControl x:Name="ContentHost" />
            </Border>
        </Grid>

        <!-- ==================== LOGIN ==================== -->
        <Border x:Name="LoginHost" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="0" />
                    <GradientStop Color="#0A3A24" Offset="0.5" />
                    <GradientStop Color="#072A1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ContentControl x:Name="LoginContentHost" />
        </Border>

        <!-- ==================== TOAST OVERLAY ==================== -->
        <ItemsControl ItemsSource="{Binding Source={x:Static local:ToastService.Items}}"
                      Panel.ZIndex="100"
                      Margin="0,18,24,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="14,11" Margin="0,0,0,8"
                            MaxWidth="360">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{Binding AccentBrush}" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Message}" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

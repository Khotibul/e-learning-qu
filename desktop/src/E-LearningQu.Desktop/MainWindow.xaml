<Window x:Class="E_LearningQu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Learning-Qu Desktop"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="ShellHost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1F2A37">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
                        <TextBlock Text="E-Learning-Qu" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="UserLabel" Foreground="#AAB4C0" FontSize="12" Margin="0,6,0,0" />
                        <TextBlock x:Name="RoleLabel" Foreground="#7FA6CC" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" x:Name="LogoutButton" Content="Keluar"
                            Margin="16,8,16,16" Padding="10" />

                    <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                             Foreground="#DDE4EC" SelectionChanged="OnMenuSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="Foreground" Value="#DDE4EC" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2E4057" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#283548" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#F4F6F8">
                <ContentControl x:Name="ContentHost" />
            </Border>
        </Grid>

        <Border x:Name="LoginHost" Visibility="Collapsed" Background="#F4F6F8">
            <ContentControl x:Name="LoginContentHost" />
        </Border>
    </Grid>
</Window>
